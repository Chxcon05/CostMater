      function getLang() {
        return localStorage.getItem('lang') || 'es';
      }

      function getTheme() {
        return localStorage.getItem('theme') || 'dark';
      }

      function applyTheme(theme) {
        if (theme === 'light') {
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
        }
      }

      function applyTranslations(lang) {
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (DICT[key] && DICT[key][lang]) {
            el.textContent = DICT[key][lang];
          }
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (DICT[key] && DICT[key][lang]) {
            el.placeholder = DICT[key][lang];
          }
        });
        document.querySelectorAll('[data-i18n-title]').forEach(el => {
          const key = el.getAttribute('data-i18n-title');
          if (DICT[key] && DICT[key][lang]) {
            el.title = DICT[key][lang];
          }
        });
        document.documentElement.lang = lang === 'en' ? 'en' : 'es';
      }

      function updateToggleUI() {
        const isLight = document.documentElement.classList.contains('light');
        const lang = getLang();

        document.querySelectorAll('[data-i18n="theme.light"], [data-i18n="theme.dark"]').forEach(el => {
          const key = isLight ? 'theme.dark' : 'theme.light';
          if (DICT[key]) el.textContent = DICT[key][lang];
        });
        document.querySelectorAll('[data-i18n="lang.switch"]').forEach(el => {
          if (DICT['lang.switch']) el.textContent = DICT['lang.switch'][lang];
        });

        document.getElementById('theme-icon-sun')?.classList.toggle('hidden', !isLight);
        document.getElementById('theme-icon-moon')?.classList.toggle('hidden', isLight);
        document.getElementById('theme-icon-sun-nav')?.classList.toggle('hidden', !isLight);
        document.getElementById('theme-icon-moon-nav')?.classList.toggle('hidden', isLight);
        const langIcon = document.getElementById('lang-icon');
        if (langIcon) langIcon.textContent = lang === 'es' ? 'EN' : 'ES';
        const langIconNav = document.getElementById('lang-icon-nav');
        if (langIconNav) langIconNav.textContent = lang === 'es' ? 'EN' : 'ES';
      }

      applyTheme(getTheme());
      applyTranslations(getLang());
      updateToggleUI();

      window.toggleTheme = function() {
        const isLight = document.documentElement.classList.contains('light');
        const newTheme = isLight ? 'dark' : 'light';
        applyTheme(newTheme);
        localStorage.setItem('theme', newTheme);
        updateToggleUI();
      };

      window.toggleLanguage = function() {
        const newLang = getLang() === 'es' ? 'en' : 'es';
        localStorage.setItem('lang', newLang);
        applyTranslations(newLang);
        updateToggleUI();
      };

      document.addEventListener('astro:after-swap', function() {
        applyTheme(getTheme());
        applyTranslations(getLang());
        updateToggleUI();
      });
    })();
  </script>
