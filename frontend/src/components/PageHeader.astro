---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header class="mb-6 animate-fade-in-up">
  <h1 class="text-2xl font-semibold text-[var(--text-primary)] tracking-tight">{title}</h1>
  {subtitle && <p class="text-[var(--text-muted)] mt-1 text-sm">{subtitle}</p>}
  <div class="mt-3 h-1 w-16 bg-[var(--accent-primary)] rounded-full"></div>
</header>