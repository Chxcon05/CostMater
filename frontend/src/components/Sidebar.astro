---
const currentPath = Astro.url.pathname;

const navItems = [
  { path: '/dashboard', label: 'Dashboard', key: 'nav.dashboard', icon: 'layout-dashboard' },
  { path: '/products', label: 'Productos', key: 'nav.products', icon: 'package' },
  { path: '/costs', label: 'Costos', key: 'nav.costs', icon: 'wallet' },
  { path: '/reports', label: 'Reportes', key: 'nav.reports', icon: 'bar-chart-2' },
  { path: '/ai', label: 'Análisis IA', key: 'nav.ai', icon: 'brain' },
  { path: '/customers', label: 'Clientes', key: 'nav.customers', icon: 'users' },
  { path: '/suppliers', label: 'Proveedores', key: 'nav.suppliers', icon: 'truck' },
  { path: '/invoices', label: 'Facturas', key: 'nav.invoices', icon: 'file-text' },
  { path: '/quotes', label: 'Cotizaciones', key: 'nav.quotes', icon: 'file' },
];

const user = typeof window !== 'undefined' ? JSON.parse(localStorage.getItem('user') || 'null') : null;
---

<aside id="sidebar" class="w-56 bg-[var(--bg-secondary)] border-r border-[var(--border-color)] min-h-screen fixed left-0 top-0 bottom-0 flex flex-col overflow-y-auto transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-40 md:w-56">
  <div id="sidebar-overlay" class="fixed inset-0 bg-black/60 z-30 md:hidden hidden"></div>
  <div class="p-5 border-b border-[var(--border-color)]">
    <a href="/dashboard" class="flex items-center gap-3 group">
      <div class="w-10 h-10 bg-[var(--accent-primary)] rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2.5" d="M4 4h8v16H4zM12 4v16M20 4v16" />
        </svg>
      </div>
      <div>
        <span class="text-lg font-bold tracking-tight">COSTMASTER</span>
        <p class="text-[10px] text-[var(--text-muted)] uppercase tracking-widest mt-0.5" data-i18n="sidebar.subtitle">Contabilidad</p>
      </div>
    </a>
  </div>

  <div class="relative">
    <button id="notifications-btn" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all duration-200 group text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-tertiary)] hover:text-[var(--text-primary)]" aria-label="Notificaciones">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <span data-i18n="nav.notifications">Notificaciones</span>
      <span id="notifications-badge" class="hidden ml-auto min-w-[20px] h-5 px-1.5 rounded-full bg-[var(--accent-danger)] text-white text-xs font-semibold flex items-center justify-center">0</span>
    </button>
    <div id="notifications-panel" class="hidden absolute left-3 right-3 top-full mt-2 z-50 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg shadow-xl overflow-hidden">
      <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--border-color)]">
        <span class="text-sm font-semibold text-[var(--text-primary)]" data-i18n="nav.notifications">Notificaciones</span>
        <button id="notifications-read-all" class="text-xs text-[var(--accent-primary)] hover:underline" data-i18n="nav.notif_read_all">Marcar todas leídas</button>
      </div>
      <div id="notifications-list" class="max-h-72 overflow-y-auto"></div>
    </div>
  </div>

  <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
    {navItems.map((item, index) => (
      <a
        href={item.path}
        class={`flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all duration-200 group text-sm ${
          currentPath.startsWith(item.path)
            ? 'bg-[var(--accent-primary)] text-white font-medium'
            : 'text-[var(--text-secondary)] hover:bg-[var(--bg-tertiary)] hover:text-[var(--text-primary)]'
        }`}
      >
        {item.icon === 'layout-dashboard' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" />
          </svg>
        )}
        {item.icon === 'package' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        )}
        {item.icon === 'wallet' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 8v10a2 2 0 002 2h12a2 2 0 002-2V8m-2 0H6a2 2 0 00-2 2v2h16v-2a2 2 0 00-2-2" />
          </svg>
        )}
        {item.icon === 'bar-chart-2' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 20V14m0 0V8m0 0V4m0 0h8m8 0V8m0 0v12m0 0V4m0 0H8" />
          </svg>
        )}
        {item.icon === 'users' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M12 4a4 4 0 100 8 4 4 0 000-8zM4 20v-2a4 4 0 014-4h8a4 4 0 014 4v2" />
          </svg>
        )}
        {item.icon === 'truck' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M5 18H4a2 2 0 01-2-2V8a2 2 0 012-2h1l3 8h10a2 2 0 012 2v8a2 2 0 01-2 2h-1m-4 0h2m2 0v-6m-2 6l-3-3m3 3l3-3" />
          </svg>
        )}
        {item.icon === 'file-text' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        )}
        {item.icon === 'file' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        )}
        {item.icon === 'brain' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        )}
        <span data-i18n={item.key}>{item.label}</span>
      </a>
    ))}
    <a
      id="admin-users-link"
      href="/admin/users"
      class="hidden items-center gap-3 px-3 py-2.5 rounded-lg transition-all duration-200 group text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-tertiary)] hover:text-[var(--text-primary)]"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M12 4a4 4 0 100 8 4 4 0 000-8zM20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2m12-9a4 4 0 100-8m2 8h.01" />
      </svg>
      <span data-i18n="nav.users">Usuarios</span>
    </a>
  </nav>

  <div class="p-3 border-t border-[var(--border-color)] space-y-0.5">
    <button
      id="theme-toggle"
      onclick="window.toggleTheme()"
      class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-tertiary)] hover:text-[var(--text-primary)] rounded-lg transition-colors"
    >
      <svg id="theme-icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <svg id="theme-icon-moon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
      </svg>
      <span data-i18n="theme.light">Modo claro</span>
    </button>
    <button
      id="lang-toggle"
      onclick="window.toggleLanguage()"
      class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-tertiary)] hover:text-[var(--text-primary)] rounded-lg transition-colors"
    >
      <span id="lang-icon" class="w-5 h-5 flex items-center justify-center text-xs font-bold">EN</span>
      <span data-i18n="lang.switch">English</span>
    </button>
  </div>

  <div class="p-3 border-t border-[var(--border-color)]">
    <div class="flex items-center gap-3 px-3 py-3 rounded-lg bg-[var(--bg-tertiary)] mb-2">
      <div class="w-9 h-9 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-full flex items-center justify-center">
        <span class="text-xs font-semibold uppercase">YO</span>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-[var(--text-primary)] truncate" id="sidebar-user-name">Usuario</p>
        <p class="text-[10px] text-[var(--text-muted)] truncate" id="sidebar-user-email">email@ejemplo.com</p>
      </div>
    </div>
    <button
      id="tutorial-btn"
      class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-tertiary)] hover:text-[var(--text-primary)] rounded-lg transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <span data-i18n="tutorial.replay">Ver tutorial</span>
    </button>
    <button
      id="logout-btn"
      class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-tertiary)] hover:text-[var(--accent-danger)] rounded-lg transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m10-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-2" />
      </svg>
      <span data-i18n="nav.logout">Cerrar sesión</span>
    </button>
  </div>
</aside>

<script>
  const user = JSON.parse(localStorage.getItem('user') || 'null');
  if (user) {
    document.getElementById('sidebar-user-name').textContent = user.name;
    document.getElementById('sidebar-user-email').textContent = user.email;
    if (user.role === 'admin') {
      const adminLink = document.getElementById('admin-users-link');
      if (adminLink) adminLink.classList.remove('hidden');
      adminLink.classList.add('flex');
    }
  }

  document.getElementById('logout-btn').addEventListener('click', () => {
    const token = localStorage.getItem('token');
    if (token) {
      fetch(`${CostMaster.API_URL}/auth/logout`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` }
      }).catch(() => {});
    }
    localStorage.removeItem('token');
    localStorage.removeItem('user');
    window.location.href = '/login';
  });

  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  
  if (overlay) {
    overlay.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
    });
  }

  document.addEventListener('astro:after-swap', () => {
    const user = JSON.parse(localStorage.getItem('user') || 'null');
    if (user) {
      const nameEl = document.getElementById('sidebar-user-name');
      const emailEl = document.getElementById('sidebar-user-email');
      if (nameEl) nameEl.textContent = user.name;
      if (emailEl) emailEl.textContent = user.email;
      const adminLink = document.getElementById('admin-users-link');
      if (adminLink) {
        adminLink.classList.toggle('hidden', user.role !== 'admin');
        adminLink.classList.toggle('flex', user.role === 'admin');
      }
    }
  });

  // Notificaciones
  (function() {
    const btn = document.getElementById('notifications-btn');
    const panel = document.getElementById('notifications-panel');
    const badge = document.getElementById('notifications-badge');
    const list = document.getElementById('notifications-list');
    const readAllBtn = document.getElementById('notifications-read-all');
    if (!btn || !panel) return;

    function getAuthHeaders() {
      const token = localStorage.getItem('token');
      return token ? { 'Authorization': `Bearer ${token}` } : null;
    }

    function renderNotifications(data) {
      const items = (data && data.items) || [];
      const unread = (data && data.unread) || 0;
      if (badge) {
        badge.textContent = unread;
        badge.classList.toggle('hidden', unread === 0);
      }
      if (!list) return;
      if (!items.length) {
        list.innerHTML = `<div class="px-4 py-6 text-center text-sm text-[var(--text-muted)]" data-i18n="nav.notif_empty">No hay notificaciones</div>`;
        return;
      }
      list.innerHTML = items.map(n => {
        const cls = n.type === 'warning' ? 'text-[var(--accent-warning)]' : n.type === 'success' ? 'text-[var(--accent-success)]' : 'text-[var(--accent-primary)]';
        return `<a href="${n.link || '/dashboard'}" data-id="${n.id}" data-read="${n.read}" class="block px-4 py-3 border-b border-[var(--border-color)] hover:bg-[var(--bg-tertiary)] transition-colors ${n.read ? 'opacity-60' : ''}">
          <div class="flex items-start gap-2">
            <span class="mt-1 w-2 h-2 rounded-full flex-shrink-0 ${n.read ? 'bg-[var(--border-color)]' : 'bg-[var(--accent-danger)]'}"></span>
            <div class="min-w-0">
              <p class="text-sm font-medium text-[var(--text-primary)] truncate">${window.CostMaster.sanitize.escapeHtml(n.title)}</p>
              <p class="text-xs text-[var(--text-muted)] mt-0.5 line-clamp-2">${window.CostMaster.sanitize.escapeHtml(n.message || '')}</p>
              <p class="text-[10px] text-[var(--text-muted)] mt-1">${new Date(n.created_at).toLocaleString('es-MX')}</p>
            </div>
          </div>
        </a>`;
      }).join('');
      list.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', async (e) => {
          const id = a.getAttribute('data-id');
          const isRead = a.getAttribute('data-read') === '1';
          if (!isRead) {
            e.preventDefault();
            const headers = getAuthHeaders();
            if (headers) {
              await fetch(`${CostMaster.API_URL}/notifications/${id}/read`, { method: 'PUT', headers }).catch(() => {});
            }
            window.location.href = a.getAttribute('href') || '/dashboard';
          }
        });
      });
    }

    async function loadNotifications() {
      const headers = getAuthHeaders();
      if (!headers) return;
      try {
        const res = await fetch(`${CostMaster.API_URL}/notifications?limit=15`, { headers });
        if (res.ok) renderNotifications(await res.json());
      } catch (e) { /* silencioso */ }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      panel.classList.toggle('hidden');
      if (!panel.classList.contains('hidden')) loadNotifications();
    });

    readAllBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const headers = getAuthHeaders();
      if (headers) {
        await fetch(`${CostMaster.API_URL}/notifications/read-all`, { method: 'POST', headers }).catch(() => {});
        loadNotifications();
      }
    });

    document.addEventListener('click', (e) => {
      if (!panel.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
        panel.classList.add('hidden');
      }
    });

    loadNotifications();
    setInterval(loadNotifications, 30000);
  })();
</script>