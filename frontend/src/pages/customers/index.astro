---
import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PageHeader from "../../components/PageHeader.astro";
---

<Layout title="Clientes">
  <div class="flex min-h-screen">
    <Sidebar />

    <main class="flex-1 p-4 md:p-8 md:ml-56 relative z-10">
      <button
        id="mobile-menu-btn"
        class="md:hidden fixed top-4 right-4 z-50 p-3 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg shadow-lg hover:border-[var(--accent-primary)] transition-all"
      >
        <svg
          class="w-6 h-6 text-[var(--text-primary)]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <PageHeader title="Clientes" subtitle="Gestiona tu base de clientes" i18nTitle="customer.page_title" i18nSubtitle="customer.page_subtitle" />

      <div class="flex flex-wrap gap-3 mb-6">
        <input
          type="text"
          id="search-input"
          placeholder="Buscar cliente..." data-i18n-placeholder="common.search"
          class="input flex-1 min-w-[200px]"
        />
        <button
          id="btn-new"
          class="btn-primary flex items-center gap-2 rounded-lg text-sm px-3 py-1.5 whitespace-nowrap" data-admin-only
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"></path></svg
          >
          <span data-i18n="common.new">Nuevo Cliente</span>
        </button>
      </div>

      <div class="card overflow-x-auto">
        <table class="w-full min-w-[640px]">
          <thead
            ><tr class="table-header"
              ><th class="table-cell text-left" data-i18n="common.name">Nombre</th><th
                class="table-cell text-left" data-i18n="common.email">Email</th
              ><th class="table-cell text-center" data-i18n="common.phone">Teléfono</th><th
                class="table-cell text-left" data-i18n="customer.country">País</th><th
                class="table-cell text-left" data-i18n="customer.city">Ciudad</th
              ><th class="table-cell text-right" data-i18n="customer.credit">Crédito</th
              ><th class="table-cell text-center" data-i18n="common.actions" data-admin-only>Acciones</th></tr
            ></thead
          >
          <tbody id="table" class="divide-y divide-[var(--border-color)]"
          ></tbody>
        </table>
        <div id="empty-msg" class="empty-state hidden">
          <div class="empty-state-icon">
            <svg class="w-8 h-8 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <p class="empty-state-title" data-i18n="customer.empty">No hay clientes registrados</p>
          <p class="empty-state-desc">Comienza agregando tu primer cliente</p>
          <button onclick="document.getElementById('btn-new').click()" class="btn-primary rounded-lg text-xs px-4 py-2" data-i18n="common.add" data-admin-only>+ Agregar</button>
        </div>
      </div>

      <div id="pagination-container"></div>
    </main>
  </div>

  <div id="modal" class="modal-overlay hidden">
    <div class="modal-content flex flex-col max-h-[90vh] border border-[var(--border-color)]">
      <div
        class="p-6 border-b border-[var(--border-color)] flex justify-between items-center flex-shrink-0"
      >
        <h3 class="text-lg font-semibold" id="modal-title" data-i18n="customer.new">Nuevo Cliente</h3>
        <button id="modal-close" class="text-slate-400 hover:text-slate-600"
          ><svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path></svg
          ></button
        >
      </div>
      <form id="form" class="p-6 space-y-4 overflow-y-auto flex-1">
        <input type="hidden" id="record-id" />
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="label" data-i18n="form.name_required">Nombre *</label><input
              type="text"
              id="name"
              class="input"
              required
            />
          </div>
          <div>
            <label class="label" data-i18n="form.email">Email</label><input
              type="email"
              id="email"
              class="input"
            />
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label class="label" data-i18n="form.phone">Teléfono</label><input
              type="text"
              id="phone"
              class="input"
            />
          </div>
          <div>
            <label class="label" data-i18n="form.address">Dirección</label><input
              type="text"
              id="address"
              class="input"
            />
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
          <div>
            <label class="label" data-i18n="form.country">País</label>
            <select id="country" class="input">
              <option value="" data-i18n="form.select">Seleccionar...</option>
              <option value="MX">México</option>
              <option value="CR">Costa Rica</option>
              <option value="CO">Colombia</option>
              <option value="AR">Argentina</option>
              <option value="ES">España</option>
              <option value="US">Estados Unidos</option>
            </select>
          </div>
          <div>
            <label class="label" data-i18n="form.city">Ciudad</label><input
              type="text"
              id="city"
              class="input"
              list="city-list"
            /><datalist id="city-list"></datalist>
          </div>
          <div>
            <label class="label" data-i18n="form.postal_code">Código Postal</label><input
              type="text"
              id="postal_code"
              class="input"
            />
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label class="label" data-i18n="form.credit_limit">Límite de crédito</label><input
              type="number"
              id="credit_limit"
              class="input"
              step="0.01"
            />
          </div>
          <div>
            <label class="label" data-i18n="form.credit_days">Días de crédito</label><input
              type="number"
              id="payment_days"
              class="input"
            />
          </div>
        </div>
        <div>
          <label class="label" data-i18n="form.notes">Notas</label><textarea
            id="notes"
            class="input"
            rows="2"></textarea>
        </div>
      </form>
      <div
        class="p-6 border-t border-[var(--border-color)] flex gap-3 justify-end flex-shrink-0"
      >
          <button
            type="button"
            id="modal-cancel"
            class="btn-secondary rounded-lg text-sm px-3 py-1.5" data-i18n="common.cancel">Cancelar</button
          >
          <button
            type="button"
            id="modal-save"
            class="btn-primary rounded-lg text-sm px-3 py-1.5" data-i18n="common.save">Guardar</button
        >
      </div>
    </div>
  </div>

  <div id="delete-modal" class="modal-overlay hidden">
    <div class="modal-content max-w-sm p-6 text-center border border-[var(--border-color)]">
      <h3 class="text-lg font-semibold mb-2" data-i18n="customer.delete_confirm">¿Eliminar cliente?</h3>
      <p class="text-slate-500 mb-6" data-i18n="customer.delete_warning">Esta acción no se puede deshacer.</p>
      <div class="flex gap-3 justify-center">
        <button id="delete-cancel" class="btn-secondary rounded-lg" data-i18n="common.cancel"
          >Cancelar</button
        >
        <button id="delete-confirm" class="btn-danger rounded-lg" data-i18n="common.delete"
          >Eliminar</button
        >
      </div>
    </div>
  </div>
</Layout>

<script is:inline src="/js/toast.js"></script>
<script is:inline src="/js/pagination.js"></script>
<script>
  console.log("Customers script loaded");

  const API_URL = CostMaster.API_URL;
  let data = [];
  let currentId = null;
  let currentPage = 1;
  const perPage = 10;

  const $ = id => document.getElementById(id);

  const citiesByCountry = {
    MX: [
      "Ciudad de México",
      "Guadalajara",
      "Monterrey",
      "Puebla",
      "Tijuana",
      "Cancún",
      "Mérida",
      "Querétaro",
    ],
    CR: [
      "San José",
      "Cartago",
      "Heredia",
      "Alajuela",
      "Puntarenas",
      "Limón",
      "Liberia",
      "Nicoya",
    ],
    CO: [
      "Bogotá",
      "Medellín",
      "Cali",
      "Barranquilla",
      "Cartagena",
      "Bucaramanga",
      "Pereira",
      "Manizales",
    ],
    AR: [
      "Buenos Aires",
      "Córdoba",
      "Rosario",
      "Mendoza",
      "Tucumán",
      "La Plata",
      "Mar del Plata",
      "Salta",
    ],
    ES: [
      "Madrid",
      "Barcelona",
      "Valencia",
      "Sevilla",
      "Zaragoza",
      "Málaga",
      "Murcia",
      "Palma",
    ],
    US: [
      "Nueva York",
      "Los Ángeles",
      "Chicago",
      "Houston",
      "Phoenix",
      "Philadelphia",
      "San Antonio",
      "San Diego",
    ],
  };

  const countrySelect = document.getElementById("country");
  const cityInput = document.getElementById("city");
  let cityList = document.getElementById("city-list");

  if (countrySelect) {
    countrySelect.addEventListener("change", function () {
      const cities = citiesByCountry[this.value] || [];
      const newList = document.createElement("datalist");
      newList.id = "city-list";
      cities.forEach(c => { const o = document.createElement("option"); o.value = c; newList.appendChild(o); });
      cityList.parentNode.replaceChild(newList, cityList);
      cityList = newList;
      cityInput.value = "";
    });
  }

  function getAuthHeaders() {
    const token = localStorage.getItem("token");
    if (!token) {
      window.location.href = "/login";
      return null;
    }
    return { Authorization: `Bearer ${token}` };
  }

  async function load() {
    const headers = getAuthHeaders();
    if (!headers) return;
    try {
      const res = await fetch(`${API_URL}/customers`, { headers });
      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Error al cargar' }));
        toast.error(err.error || 'Error al cargar clientes');
        return;
      }
      data = await res.json();
      render();
    } catch (e) {
      console.error(e);
      toast.error('Error al conectar con el servidor');
    }
  }

  function render() {
    const search = $('search-input').value.toLowerCase();
    const filtered = data.filter(
      (d) => !search || d.name.toLowerCase().includes(search),
    );

    const { items, totalPages } = CostMaster.Pagination.paginate(filtered, currentPage, perPage);

    const tbody = $('table');
    const empty = $('empty-msg');

    if (filtered.length === 0) {
      tbody.innerHTML = "";
      empty.classList.remove("hidden");
      CostMaster.Pagination.render($('pagination-container'), { page: 1, totalPages: 0, onPageChange: () => {} });
      return;
    }
    empty.classList.add("hidden");
    const esc = CostMaster.sanitize.escapeHtml;
    tbody.innerHTML = items
      .map(
        (d) => `
      <tr class="hover:bg-[#22222c]">
        <td class="table-cell font-medium text-left text-[var(--text-primary)]">${esc(d.name)}</td>
        <td class="table-cell text-left">${esc(d.email) || "-"}</td>
        <td class="table-cell text-center">${esc(d.phone) || "-"}</td>
        <td class="table-cell text-left">${esc(d.country) || "-"}</td>
        <td class="table-cell text-left">${esc(d.city) || "-"}</td>
        <td class="table-cell font-mono text-right">${formatCurrency(d.credit_limit)}</td>
        ${CostMaster.isAdmin() ? `<td class="table-cell text-center">
          <div class="flex gap-2 justify-center">
            <button data-id="${d.id}" class="edit-btn p-1 text-slate-400 hover:text-primary-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg></button>
            <button data-id="${d.id}" class="delete-btn p-1 text-slate-400 hover:text-red-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg></button>
          </div>
        </td>` : ''}
      </tr>
    `,
      )
      .join("");

    CostMaster.Pagination.render($('pagination-container'), { page: currentPage, totalPages, onPageChange: (p) => { currentPage = p; render(); } });

    tbody.querySelectorAll(".edit-btn").forEach((btn) => {
      btn.addEventListener("click", () => edit(parseInt(btn.dataset.id)));
    });
    tbody.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", () =>
        confirmDelete(parseInt(btn.dataset.id)),
      );
    });
  }

  function formatCurrency(v) {
    return new Intl.NumberFormat("es-MX", {
      style: "currency",
      currency: "MXN",
    }).format(v || 0);
  }

  function validateField(id, condition) {
    const field = $(id);
    const group = field.parentElement;
    if (!condition) { group.classList.add('field-error'); return false; }
    group.classList.remove('field-error');
    return true;
  }

  function openModal(id = null) {
    $('modal').classList.remove("hidden");
    $('btn-new').classList.add("hidden");
    $('form').reset();
    $('record-id').value = "";
    $('modal-title').textContent = "Nuevo Cliente";

    document.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));

    if (id) {
      const r = data.find((d) => d.id === id);
      if (r) {
        $('record-id').value = r.id;
        [
          "name",
          "email",
          "phone",
          "address",
          "city",
          "postal_code",
          "credit_limit",
          "payment_days",
          "notes",
          "country",
        ].forEach((f) => {
          $(f).value = r[f] || "";
        });
        if (r.country && countrySelect) {
          countrySelect.dispatchEvent(new Event("change"));
        }
        $('modal-title').textContent = "Editar Cliente";
      }
    }
  }

  function closeModal() {
    $('modal').classList.add("hidden");
    $('btn-new').classList.remove("hidden");
  }
  function edit(id) {
    openModal(id);
  }

  async function save() {
    const headers = getAuthHeaders();
    if (!headers) return;

    if (!validateField('name', $('name').value.trim())) {
      toast.warning('El nombre del cliente es requerido');
      return;
    }

    const id = $('record-id').value;

    const fields = [
      "name",
      "email",
      "phone",
      "address",
      "city",
      "postal_code",
      "credit_limit",
      "payment_days",
      "notes",
      "country",
    ];
    const body = {};
    fields.forEach((f) => {
      const val = $(f).value;
      body[f] =
        val !== ""
          ? val
          : f === "credit_limit" || f === "payment_days"
            ? 0
            : "";
    });

    const btn = $('modal-save');
    btn.classList.add('btn-loading');

    try {
      console.log("Saving customer:", body);
      const res = await fetch(`${API_URL}/customers${id ? "/" + id : ""}`, {
        method: id ? "PUT" : "POST",
        headers: { ...headers, "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        closeModal();
        toast.success(window.t ? window.t('common.saved') : 'Guardado correctamente');
        load();
      } else {
        const error = await res.json().catch(() => ({ error: 'Error al guardar' }));
        console.error("Save error:", error);
        toast.error(error.error || 'Error al guardar el cliente');
      }
    } catch (e) {
      console.error("Save error:", e);
      toast.error('Error al guardar');
    } finally {
      btn.classList.remove('btn-loading');
    }
  }

  function confirmDelete(id) {
    currentId = id;
    $('delete-modal').classList.remove("hidden");
  }

  async function deleteRecord() {
    const headers = getAuthHeaders();
    if (!headers || !currentId) return;
    try {
      await fetch(`${API_URL}/customers/${currentId}`, {
        method: "DELETE",
        headers,
      });
      $('delete-modal').classList.add("hidden");
      currentId = null;
      toast.success(window.t ? window.t('common.deleted') : 'Eliminado');
      load();
    } catch (e) {
      toast.error('Error al eliminar');
    }
  }

  let searchTimeout;
  $('search-input').addEventListener("input", () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => { currentPage = 1; render(); }, 300);
  });
  $('btn-new').addEventListener("click", () => {
    openModal();
  });
  $('mobile-menu-btn').addEventListener("click", () => {
    document.querySelector("aside").classList.toggle("-translate-x-full");
  });
  $('modal-close').addEventListener("click", () => closeModal());
  $('modal-cancel').addEventListener("click", () => closeModal());
  $('modal-save').addEventListener("click", () => save());
  $('delete-cancel').addEventListener("click", () =>
    $('delete-modal').classList.add("hidden"),
  );
  $('delete-confirm').addEventListener("click", () => deleteRecord());

  ['modal', 'delete-modal'].forEach(id => {
    $(id).addEventListener('click', e => { if (e.target.classList.contains('modal-overlay')) $(id).classList.add('hidden'); });
  });

  render();
  load();
</script>
