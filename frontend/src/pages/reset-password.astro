---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Restablecer Contraseña">
  <script>
    if (localStorage.getItem('token')) {
      window.location.href = '/dashboard';
    }
  </script>
  <div class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
    <div class="login-bg"></div>
    <div class="login-dots"></div>

    <div class="w-full max-w-sm relative z-10">
      <div class="login-header" style="opacity: 0; transform: translateY(-20px);">
        <a href="/" class="inline-flex items-center gap-3 group">
          <div class="w-10 h-10 bg-[var(--accent-primary)] rounded-sm flex items-center justify-center">
            <svg class="w-6 h-6 text-white group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2.5" d="M4 4h8v16H4zM12 4v16M20 4v16" />
            </svg>
          </div>
          <div class="text-left">
            <span class="text-xl font-bold tracking-tight">COSTMASTER</span>
            <p class="text-[10px] text-[var(--text-muted)] uppercase tracking-widest mt-0.5" data-i18n="sidebar.subtitle">Contabilidad</p>
          </div>
        </a>
      </div>

      <div class="card p-7 login-form" style="opacity: 0; transform: translateY(20px) scale(0.95);">
        <h2 class="text-lg font-semibold text-[var(--text-primary)] mb-1" data-i18n="auth.reset_title">Nueva contraseña</h2>
        <p class="text-[var(--text-muted)] text-sm mb-6" data-i18n="auth.reset_subtitle">Elige una nueva contraseña para tu cuenta</p>

        <form id="reset-form" class="space-y-4">
          <div class="form-group" style="opacity: 0; transform: translateX(-10px);">
            <label class="label" for="password" data-i18n="auth.new_password">Nueva contraseña</label>
            <input type="password" id="password" name="password" class="input" placeholder="••••••••" required minlength="6" />
          </div>

          <div class="form-group" style="opacity: 0; transform: translateX(-10px);">
            <label class="label" for="confirm-password" data-i18n="auth.confirm_password">Confirmar contraseña</label>
            <input type="password" id="confirm-password" name="confirm-password" class="input" placeholder="••••••••" required />
          </div>

          <div id="error-message" class="text-[var(--accent-danger)] text-xs hidden mt-1"></div>
          <div id="success-message" class="text-emerald-400 text-xs hidden mt-1"></div>

          <button type="submit" class="btn btn-primary w-full py-2.5" style="border-radius: 4px">
            <span data-i18n="auth.reset_submit">Restablecer contraseña</span>
          </button>
        </form>

        <p class="text-center text-[var(--text-muted)] text-sm mt-6">
          <a href="/login" class="text-[var(--accent-primary)] hover:text-[var(--accent-primary)] font-semibold transition-colors" data-i18n="auth.back_login">Volver a iniciar sesión</a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .login-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 30%, rgba(139, 92, 246, 0.1) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 70%, rgba(16, 185, 129, 0.06) 0%, transparent 50%);
  }

  .login-dots {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(139, 92, 246, 0.12) 1px, transparent 0);
    background-size: 32px 32px;
    opacity: 0.4;
  }
</style>

<script>
  const loginHeader = document.querySelector('.login-header');
  const loginForm = document.querySelector('.login-form');
  const formGroups = document.querySelectorAll('.form-group');

  setTimeout(() => {
    loginHeader.style.transition = 'all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    loginHeader.style.opacity = '1';
    loginHeader.style.transform = 'translateY(0)';
  }, 100);

  setTimeout(() => {
    loginForm.style.transition = 'all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    loginForm.style.opacity = '1';
    loginForm.style.transform = 'translateY(0) scale(1)';
  }, 300);

  formGroups.forEach((group, i) => {
    setTimeout(() => {
      group.style.transition = 'all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      group.style.opacity = '1';
      group.style.transform = 'translateX(0)';
    }, 500 + (i * 100));
  });
</script>

<script>
  const API_URL = CostMaster.API_URL;
  const urlParams = new URLSearchParams(window.location.search);
  const token = urlParams.get('token');

  const errorDiv = document.getElementById('error-message');
  const successDiv = document.getElementById('success-message');
  const submitBtn = document.querySelector('#reset-form button[type="submit"]');

  if (!token) {
    errorDiv.textContent = window.t('auth.reset_invalid_token');
    errorDiv.classList.remove('hidden');
    submitBtn.disabled = true;
  }

  document.getElementById('reset-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirm-password').value;

    errorDiv.classList.add('hidden');
    successDiv.classList.add('hidden');

    if (password !== confirmPassword) {
      errorDiv.textContent = window.t('auth.passwords_mismatch');
      errorDiv.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;

    try {
      const res = await fetch(`${API_URL}/auth/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, password })
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Error al restablecer la contraseña');
      }

      successDiv.textContent = window.t('auth.reset_success');
      successDiv.classList.remove('hidden');
      setTimeout(() => { window.location.href = '/login'; }, 1800);
    } catch (error) {
      errorDiv.textContent = error.message;
      errorDiv.classList.remove('hidden');
      submitBtn.disabled = false;
    }
  });
</script>
