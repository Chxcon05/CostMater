---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="Cotizaciones">
  <div class="flex min-h-screen">
    <Sidebar />
    
    <main class="flex-1 p-4 md:p-8 md:ml-56 relative z-10">
      <button id="mobile-menu-btn" class="md:hidden fixed top-4 right-4 z-50 p-3 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg shadow-lg hover:border-[var(--accent-primary)] transition-all">
        <svg class="w-6 h-6 text-[var(--text-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <PageHeader title="Cotizaciones" subtitle="Genera y gestiona presupuestos" i18nTitle="quote.page_title" i18nSubtitle="quote.page_subtitle" />
      
      <div class="flex flex-wrap gap-3 mb-6">
        <input id="search-input" type="search" placeholder="Buscar por folio o cliente..." data-i18n-placeholder="common.search" class="input flex-1 min-w-[180px]" />
        <select id="status-filter" class="input flex-1 min-w-[180px]">
          <option value="" data-i18n="common.all">Todos los estados</option>
          <option value="borrador" data-i18n="quote.draft">Borrador</option>
          <option value="enviada" data-i18n="quote.sent">Enviada</option>
          <option value="aprobada" data-i18n="quote.approved">Aprobada</option>
          <option value="rechazada" data-i18n="quote.rejected">Rechazada</option>
        </select>
        <button
          id="btn-new"
          class="btn-primary flex items-center gap-2 rounded-lg text-sm px-3 py-1.5 whitespace-nowrap" data-admin-only
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"></path></svg
          >
          <span data-i18n="common.new">Nueva Cotización</span>
        </button>
        <button id="export-excel" class="btn-secondary rounded-lg text-sm px-3 py-1.5 whitespace-nowrap" data-i18n="common.export_excel">Exportar Excel</button>
      </div>

      <div class="card overflow-x-auto">
        <table class="w-full min-w-[640px]">
          <thead><tr class="table-header"><th class="table-cell text-left" data-i18n="quote.folio">Folio</th><th class="table-cell text-left" data-i18n="quote.customer">Cliente</th><th class="table-cell text-left" data-i18n="common.date">Fecha</th><th class="table-cell text-right" data-i18n="common.total">Total</th><th class="table-cell text-center" data-i18n="common.status">Estado</th><th class="table-cell text-center" data-i18n="common.actions" data-admin-only>Acciones</th></tr></thead>
          <tbody id="table" class="divide-y divide-[var(--border-color)]"></tbody>
        </table>
        <div id="empty" class="empty-state hidden">
          <div class="empty-state-icon">
            <svg class="w-8 h-8 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <p class="empty-state-title" data-i18n="quote.empty">No hay cotizaciones</p>
          <p class="empty-state-desc">Crea tu primera cotización para comenzar</p>
        </div>
      </div>

      <div id="pagination-container"></div>
    </main>
  </div>

  <div id="modal" class="modal-overlay hidden">
    <div class="modal-content max-w-2xl border border-[var(--border-color)]">
      <div class="p-6 border-b border-[var(--border-color)] flex justify-between items-center">
        <h3 class="text-lg font-semibold" id="modal-title" data-i18n="quote.new">Nueva Cotización</h3>
        <button id="modal-close" class="text-slate-400 hover:text-slate-600"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
      </div>
      <form id="form" class="p-6 space-y-4">
        <input type="hidden" id="record-id" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div><label class="label" data-i18n="quote.form_client">Cliente</label><select id="customer_id" class="input"><option value="" data-i18n="quote.no_client">Sin cliente</option></select></div>
          <div><label class="label" data-i18n="quote.form_validity">Validez (días) *</label><input type="number" id="validity_days" class="input" value="15" required /><p class="field-error-msg">La validez es requerida</p></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
          <div><label class="label" data-i18n="quote.form_discount">Descuento (%)</label><input type="number" id="discount_percent" class="input" step="0.01" value="0" /></div>
          <div><label class="label" data-i18n="quote.form_vat">IVA (%)</label><input type="number" id="tax_percent" class="input" step="0.01" value="16" /></div>
          <div><label class="label" data-i18n="quote.form_valid_from">Válida desde *</label><input type="date" id="valid_from" class="input" required /><p class="field-error-msg">La fecha es requerida</p></div>
        </div>
        <div><label class="label" data-i18n="quote.form_notes">Notas</label><textarea id="notes" class="input" rows="2"></textarea></div>
        
        <div class="border border-[var(--border-color)] rounded-lg p-4">
          <div class="flex justify-between items-center mb-4">
            <h4 class="font-medium" data-i18n="quote.concepts">Conceptos</h4>
            <button type="button" id="add-item-btn" class="text-primary-600 text-sm font-medium hover:text-primary-700" data-i18n="common.new">+ Agregar concepto</button>
          </div>
          <div class="grid grid-cols-4 gap-2 mb-2 text-xs text-[var(--text-muted)] font-medium uppercase tracking-wider">
            <span data-i18n="common.description">Descripción</span>
            <span data-i18n="common.quantity">Cantidad</span>
            <span data-i18n="common.price">Precio</span>
            <span></span>
          </div>
          <div id="items-container" class="space-y-2"></div>
        </div>
      </form>
      <div class="p-6 border-t border-[var(--border-color)] flex gap-3 justify-end">
        <button type="button" id="modal-cancel" class="btn-secondary rounded-lg text-sm px-3 py-1.5" data-i18n="common.cancel">Cancelar</button>
        <button type="button" id="modal-save" class="btn-primary rounded-lg text-sm px-3 py-1.5" data-i18n="common.save">Guardar</button>
      </div>
    </div>
  </div>

  <div id="delete-modal" class="modal-overlay hidden">
    <div class="modal-content max-w-sm p-6 text-center border border-[var(--border-color)]">
      <h3 class="text-lg font-semibold mb-2" data-i18n="quote.delete_confirm">¿Eliminar cotización?</h3>
      <p class="text-sm text-[var(--text-muted)] mb-4">Esta acción no se puede deshacer</p>
      <div class="flex gap-3 justify-center">
        <button id="delete-cancel" class="btn-secondary rounded-lg" data-i18n="common.cancel">Cancelar</button>
        <button id="delete-confirm" class="btn-danger rounded-lg" data-i18n="common.delete">Eliminar</button>
      </div>
    </div>
  </div>

  <div id="status-modal" class="modal-overlay hidden">
    <div class="modal-content max-w-sm p-6 border border-[var(--border-color)]">
      <h3 class="text-lg font-semibold mb-4" data-i18n="quote.change_status">Cambiar Estado</h3>
      <select id="new-status" class="input mb-4">
        <option value="borrador" data-i18n="quote.draft">Borrador</option>
        <option value="enviada" data-i18n="quote.sent">Enviada</option>
        <option value="aprobada" data-i18n="quote.approved">Aprobada</option>
        <option value="rechazada" data-i18n="quote.rejected">Rechazada</option>
      </select>
      <div class="flex gap-3 justify-end">
        <button id="status-cancel" class="btn-secondary rounded-lg text-sm px-3 py-1.5" data-i18n="common.cancel">Cancelar</button>
        <button id="status-confirm" class="btn-primary rounded-lg text-sm px-3 py-1.5" data-i18n="common.save">Actualizar</button>
      </div>
    </div>
  </div>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script is:inline src="/js/toast.js"></script>
<script is:inline src="/js/pagination.js"></script>
<script>
  const API_URL = CostMaster.API_URL;
  let data = [], customers = [], products = [], currentId = null, items = [];
  let currentPage = 1;
  const perPage = 10;

  const $ = id => document.getElementById(id);

  function getAuthHeaders() {
    const token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login'; return null; }
    return { 'Authorization': `Bearer ${token}` };
  }

  async function load() {
    const headers = getAuthHeaders();
    if (!headers) return;
    try {
      const [quotesRes, custRes, prodRes] = await Promise.all([
        fetch(`${API_URL}/quotes`, { headers }),
        fetch(`${API_URL}/customers`, { headers }),
        fetch(`${API_URL}/products`, { headers })
      ]);
      if (!quotesRes.ok) throw new Error('Error al cargar cotizaciones');
      data = await quotesRes.json();
      customers = await custRes.json();
      products = await prodRes.json();
      currentPage = 1;
      populateCustomers();
      render();
    } catch (e) {
      console.error(e);
      toast.error(window.t ? window.t('common.error_loading') : 'Error al cargar datos');
    }
  }

  function populateCustomers() {
    const esc = CostMaster.sanitize.escapeHtml;
    const sel = $('customer_id');
    sel.innerHTML = '<option value="">Sin cliente</option>' + customers.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join('');
  }

  function render() {
    const status = $('status-filter').value;
    const q = ($('search-input')?.value || '').toLowerCase();
    const filtered = data.filter(d => {
      if (status && d.status !== status) return false;
      if (q && !(String(d.quote_number || '').toLowerCase().includes(q) || String(d.customer_name || '').toLowerCase().includes(q))) return false;
      return true;
    });
    const tbody = $('table');
    const empty = $('empty');
    
    if (filtered.length === 0) { tbody.innerHTML = ''; empty.classList.remove('hidden'); $('table').closest('.card').querySelector('table').style.display = 'none'; CostMaster.Pagination.render($('pagination-container'), { page: 1, totalPages: 0 }); return; }
    empty.classList.add('hidden');
    $('table').closest('.card').querySelector('table').style.display = '';

    const { items: pageItems, totalPages } = CostMaster.Pagination.paginate(filtered, currentPage, perPage);

    const esc = CostMaster.sanitize.escapeHtml;
    tbody.innerHTML = pageItems.map(d => `
      <tr class="hover:bg-[#22222c]">
        <td class="table-cell font-mono font-medium text-left">${esc(d.quote_number)}</td>
        <td class="table-cell text-left">${esc(d.customer_name) || '-'}</td>
        <td class="table-cell text-left">${new Date(d.created_at).toLocaleDateString('es-MX')}</td>
        <td class="table-cell font-mono font-medium text-right">${formatCurrency(d.total)}</td>
        <td class="table-cell text-center"><span class="px-2 py-1 rounded text-xs font-medium ${getStatusClass(d.status)}">${d.status}</span></td>
        ${CostMaster.isAdmin() ? `<td class="table-cell text-center">
          <div class="flex gap-2 justify-center">
            <button data-id="${d.id}" class="status-btn p-1 text-slate-400 hover:text-primary-600" title="Cambiar estado"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg></button>
            <button data-id="${d.id}" class="delete-btn p-1 text-slate-400 hover:text-red-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg></button>
          </div>
        </td>` : ''}
      </tr>
    `).join('');
    
    CostMaster.Pagination.render($('pagination-container'), { page: currentPage, totalPages, onPageChange: (p) => { currentPage = p; render(); } });

    tbody.querySelectorAll('.status-btn').forEach(btn => {
      btn.addEventListener('click', () => changeStatus(parseInt(btn.dataset.id)));
    });
    tbody.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', () => confirmDelete(parseInt(btn.dataset.id)));
    });
  }

  function getStatusClass(s) {
    const classes = { borrador: 'bg-slate-500/20 text-slate-300', enviada: 'bg-blue-500/20 text-blue-400', aprobada: 'bg-emerald-500/20 text-emerald-400', rechazada: 'bg-red-500/20 text-red-400', vencida: 'bg-amber-500/20 text-amber-400' };
    return classes[s] || 'bg-slate-500/20 text-slate-300';
  }

  function formatCurrency(v) { return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v || 0); }

  function validateField(id, condition) {
    const field = $(id);
    const group = field.closest('div') || field.parentElement;
    if (!condition) { group.classList.add('field-error'); return false; }
    group.classList.remove('field-error');
    return true;
  }

  function clearValidation() {
    document.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));
  }

  function addItem() {
    items.push({ description: '', quantity: 1, unit_price: 0, cost: 0 });
    renderItems();
  }

  function renderItems() {
    const container = $('items-container');
    const esc = CostMaster.sanitize.escapeHtml;
    container.innerHTML = items.map((item, i) => `
      <div class="grid grid-cols-4 gap-2 items-center" data-index="${i}">
        <input type="text" placeholder="Descripción" class="input item-desc" value="${esc(item.description)}" />
        <input type="number" placeholder="Cantidad" class="input item-qty" value="${item.quantity}" />
        <input type="number" placeholder="Precio" class="input item-price" step="0.01" value="${item.unit_price}" />
        <button type="button" class="text-red-500 hover:text-red-700 item-remove">✕</button>
      </div>
    `).join('') || '<p class="text-slate-400 text-sm">Sin conceptos agregados</p>';
  }

  function openModal(id = null) {
    clearValidation();
    $('modal').classList.remove('hidden');
    $('form').reset();
    $('record-id').value = '';
    $('modal-title').textContent = 'Nueva Cotización';
    items = [];
    renderItems();
    $('valid_from').value = new Date().toISOString().split('T')[0];
    if (id) { const r = data.find(d => d.id === id); if (r) { $('record-id').value = r.id; $('customer_id').value = r.customer_id || ''; $('validity_days').value = r.validity_days; $('discount_percent').value = r.discount_percent; $('notes').value = r.notes || ''; $('modal-title').textContent = 'Editar Cotización'; }}
  }

  function closeModal() { $('modal').classList.add('hidden'); clearValidation(); }

  async function save() {
    const headers = getAuthHeaders();
    if (!headers) return;

    if (!validateField('validity_days', $('validity_days').value)) {
      toast.warning('La validez es requerida');
      return;
    }
    if (!validateField('valid_from', $('valid_from').value)) {
      toast.warning('La fecha es requerida');
      return;
    }

    const id = $('record-id').value;
    const body = {
      customer_id: $('customer_id').value || null,
      validity_days: parseInt($('validity_days').value) || 15,
      discount_percent: parseFloat($('discount_percent').value) || 0,
      tax_percent: parseFloat($('tax_percent').value) || 16,
      valid_from: $('valid_from').value,
      notes: $('notes').value,
      items: items.filter(i => i.description)
    };

    const btn = $('modal-save');
    btn.classList.add('btn-loading');

    try {
      const res = await fetch(`${API_URL}/quotes${id ? '/' + id : ''}`, { method: id ? 'PUT' : 'POST', headers: { ...headers, 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (res.ok) {
        closeModal();
        toast.success(window.t ? window.t('common.saved') : 'Guardado correctamente');
        load();
      } else {
        const err = await res.json().catch(() => ({ error: 'Error al guardar' }));
        toast.error(err.error || 'Error al guardar la cotización');
      }
    } catch (e) {
      toast.error(window.t ? window.t('common.error_saving') : 'Error al guardar');
    } finally {
      btn.classList.remove('btn-loading');
    }
  }

  function changeStatus(id) {
    currentId = id;
    const r = data.find(d => d.id === id);
    if (r) $('new-status').value = r.status || 'borrador';
    $('status-modal').classList.remove('hidden');
  }

  async function updateStatus() {
    const headers = getAuthHeaders();
    if (!headers || !currentId) return;
    const status = $('new-status').value;

    const btn = $('status-confirm');
    btn.classList.add('btn-loading');

    try {
      const res = await fetch(`${API_URL}/quotes/${currentId}`, { method: 'PUT', headers: { ...headers, 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
      if (res.ok) {
        $('status-modal').classList.add('hidden');
        currentId = null;
        toast.success(window.t ? window.t('common.saved') : 'Estado actualizado');
        load();
      } else {
        const err = await res.json().catch(() => ({ error: 'Error al actualizar' }));
        toast.error(err.error || 'Error al actualizar estado');
      }
    } catch (e) {
      toast.error(window.t ? window.t('common.error_saving') : 'Error al actualizar estado');
    } finally {
      btn.classList.remove('btn-loading');
    }
  }

  function confirmDelete(id) { currentId = id; $('delete-modal').classList.remove('hidden'); }

  async function deleteRecord() {
    const headers = getAuthHeaders();
    if (!headers || !currentId) return;
    try {
      const res = await fetch(`${API_URL}/quotes/${currentId}`, { method: 'DELETE', headers });
      if (res.ok) {
        toast.success(window.t ? window.t('common.deleted') : 'Eliminado');
      } else {
        toast.error('Error al eliminar la cotización');
      }
      $('delete-modal').classList.add('hidden');
      currentId = null;
      load();
    } catch (e) {
      toast.error(window.t ? window.t('common.error') : 'Error al eliminar');
    }
  }

  $('status-filter').addEventListener('change', () => { currentPage = 1; render(); });
  $('search-input')?.addEventListener('input', () => { currentPage = 1; render(); });
  $('btn-new').addEventListener('click', () => openModal());

  $('export-excel').addEventListener('click', () => {
    if (!data.length) { toast.warning(window.t ? window.t('common.no_results') : 'Sin datos para exportar'); return; }
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(data.map(d => ({
      Folio: d.quote_number, Cliente: d.customer_name || '', Fecha: d.created_at,
      Total: d.total, Estado: d.status
    }))), 'Cotizaciones');
    XLSX.writeFile(wb, `CostMaster-Cotizaciones-${new Date().toISOString().slice(0, 10)}.xlsx`);
  });
  $('mobile-menu-btn').addEventListener('click', () => {
    document.querySelector('aside').classList.toggle('-translate-x-full');
  });
  $('modal-close').addEventListener('click', () => closeModal());
  $('modal-cancel').addEventListener('click', () => closeModal());
  $('modal-save').addEventListener('click', () => save());
  $('add-item-btn').addEventListener('click', () => addItem());
  $('delete-cancel').addEventListener('click', () => $('delete-modal').classList.add('hidden'));
  $('delete-confirm').addEventListener('click', () => deleteRecord());
  $('status-cancel').addEventListener('click', () => $('status-modal').classList.add('hidden'));
  $('status-confirm').addEventListener('click', () => updateStatus());

  ['modal', 'delete-modal', 'status-modal'].forEach(id => {
    $(id).addEventListener('click', e => { if (e.target.classList.contains('modal-overlay')) $(id).classList.add('hidden'); });
  });

  $('items-container').addEventListener('input', e => {
    const div = e.target.closest('[data-index]');
    if (!div) return;
    const i = parseInt(div.dataset.index);
    if (e.target.classList.contains('item-desc')) items[i].description = e.target.value;
    if (e.target.classList.contains('item-qty')) items[i].quantity = parseFloat(e.target.value) || 1;
    if (e.target.classList.contains('item-price')) items[i].unit_price = parseFloat(e.target.value) || 0;
  });
  $('items-container').addEventListener('click', e => {
    if (e.target.classList.contains('item-remove')) {
      const div = e.target.closest('[data-index]');
      if (!div) return;
      items.splice(parseInt(div.dataset.index), 1);
      renderItems();
    }
  });

  load();
</script>
