---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="Reportes">
  <div class="flex min-h-screen">
    <Sidebar />

    <main class="flex-1 p-4 md:p-8 md:ml-56 relative z-10">
      <button id="mobile-menu-btn" class="md:hidden fixed top-4 right-4 z-50 p-3 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg shadow-lg hover:border-[var(--accent-primary)] transition-all">
        <svg class="w-6 h-6 text-[var(--text-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <PageHeader title="Reportes" subtitle="Análisis financiero y estadísticas" i18nTitle="report.page_title" i18nSubtitle="report.page_subtitle" />

      <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <div class="flex items-center gap-2">
          <label class="text-sm text-[var(--text-muted)]" data-i18n="report.start_date">Fecha inicio</label>
          <input type="date" id="filter-start-date" class="px-3 py-2 text-sm bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg text-[var(--text-primary)] focus:border-[var(--accent-primary)] focus:outline-none transition-colors" />
        </div>
        <div class="flex items-center gap-2">
          <label class="text-sm text-[var(--text-muted)]" data-i18n="report.end_date">Fecha fin</label>
          <input type="date" id="filter-end-date" class="px-3 py-2 text-sm bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg text-[var(--text-primary)] focus:border-[var(--accent-primary)] focus:outline-none transition-colors" />
        </div>
        <button id="filter-apply" class="px-4 py-2 text-sm font-medium bg-[var(--accent-primary)] text-white rounded-lg hover:opacity-90 transition-opacity" data-i18n="common.apply">Aplicar</button>
        <button id="filter-clear" class="px-4 py-2 text-sm font-medium border border-[var(--border-color)] text-[var(--text-secondary)] rounded-lg hover:bg-[var(--bg-tertiary)] transition-colors" data-i18n="common.clear">Limpiar</button>
        <div class="flex-1"></div>
        <button id="export-pdf" class="px-4 py-2 text-sm font-medium bg-[var(--accent-danger)]/10 text-[var(--accent-danger)] border border-[var(--accent-danger)]/30 rounded-lg hover:bg-[var(--accent-danger)]/20 transition-colors" data-i18n="common.export_pdf">Exportar PDF</button>
        <button id="export-excel" class="px-4 py-2 text-sm font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-lg hover:bg-emerald-500/20 transition-colors" data-i18n="common.export_excel">Exportar Excel</button>
      </div>

      <div id="kpi-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-8">
        <div class="card p-5">
          <div class="text-sm text-[var(--text-muted)] mb-1" data-i18n="report.total_costs">Total Costos</div>
          <div class="text-2xl font-bold font-mono text-gradient" id="kpi-total">$0</div>
        </div>
        <div class="card p-5">
          <div class="text-sm text-[var(--text-muted)] mb-1" data-i18n="report.avg_cost">Costo Promedio</div>
          <div class="text-2xl font-bold font-mono text-[var(--text-primary)]" id="kpi-avg">$0</div>
        </div>
        <div class="card p-5">
          <div class="text-sm text-[var(--text-muted)] mb-1" data-i18n="report.max_cost">Mayor Costo</div>
          <div class="text-2xl font-bold font-mono text-red-400" id="kpi-max">$0</div>
        </div>
        <div class="card p-5">
          <div class="text-sm text-[var(--text-muted)] mb-1" data-i18n="report.min_cost">Menor Costo</div>
          <div class="text-2xl font-bold font-mono text-emerald-400" id="kpi-min">$0</div>
        </div>
      </div>

      <div id="breakeven-card" class="card p-6 mb-6">
        <h3 class="font-semibold text-[var(--text-primary)] mb-4" data-i18n="report.breakeven_title">Punto de Equilibrio</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" id="breakeven-content">
          <div class="p-4 bg-[var(--bg-tertiary)] rounded-lg border border-[var(--border-color)]">
            <div class="text-xs text-[var(--text-muted)] mb-1" data-i18n="report.fixed_costs">Costos Fijos</div>
            <div class="text-lg font-bold font-mono text-[var(--text-primary)]" id="breakeven-fixed">$0</div>
          </div>
          <div class="p-4 bg-[var(--bg-tertiary)] rounded-lg border border-[var(--border-color)]">
            <div class="text-xs text-[var(--text-muted)] mb-1" data-i18n="report.contribution_ratio">Margen de Contribución</div>
            <div class="text-lg font-bold font-mono text-[var(--text-primary)]" id="breakeven-ratio">0%</div>
          </div>
          <div class="p-4 bg-[var(--bg-tertiary)] rounded-lg border border-[var(--border-color)]">
            <div class="text-xs text-[var(--text-muted)] mb-1" data-i18n="report.breakeven_revenue">Ventas de Equilibrio</div>
            <div class="text-lg font-bold font-mono text-gradient" id="breakeven-revenue">$0</div>
          </div>
        </div>
      </div>

      <div class="card p-6 mb-6">
        <h3 class="font-semibold text-[var(--text-primary)] mb-4" data-i18n="report.trend_title">Tendencia de Costos (Últimos 6 meses)</h3>
        <div id="trend-chart-container" class="h-64">
          <canvas id="trendChart"></canvas>
        </div>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="table-header"><th class="table-cell" data-i18n="report.period">Período</th><th class="table-cell" data-i18n="common.amount">Monto</th><th class="table-cell" data-i18n="report.variation">Variación</th></tr></thead>
            <tbody id="variations-table" class="divide-y divide-[var(--border-color)]"></tbody>
          </table>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-6 mb-6">
        <div class="card p-6">
          <h3 class="font-semibold text-[var(--text-primary)] mb-4" data-i18n="report.distribution_title">Distribución de Costos por Tipo</h3>
          <div id="type-chart-container" class="h-64"><canvas id="typeChart"></canvas></div>
        </div>
        <div class="card p-6">
          <h3 class="font-semibold text-[var(--text-primary)] mb-4" data-i18n="report.by_product_title">Costos por Producto</h3>
          <div id="product-chart-container" class="h-64"><canvas id="productChart"></canvas></div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 class="font-semibold text-[var(--text-primary)] mb-4" data-i18n="report.rentability_title">Análisis de Rentabilidad</h3>
          <div id="rentability-container" class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead><tr class="table-header"><th class="table-cell" data-i18n="common.name">Producto</th><th class="table-cell" data-i18n="report.cost">Costo</th><th class="table-cell" data-i18n="report.selling_price">Venta</th><th class="table-cell" data-i18n="report.margin">Margen</th></tr></thead>
              <tbody id="rentability-table" class="divide-y divide-[var(--border-color)]"></tbody>
            </table>
          </div>
        </div>
        <div class="space-y-6">
          <div class="card p-6">
            <h3 class="font-semibold text-[var(--text-primary)] mb-4" data-i18n="report.audit_title">Historial de Auditoría</h3>
            <div id="audit-container" class="overflow-y-auto max-h-56">
              <div id="audit-list" class="space-y-2"></div>
            </div>
          </div>
          <div class="card p-6">
            <h3 class="font-semibold text-[var(--text-primary)] mb-4" data-i18n="report.cost_history_title">Historial de Costos</h3>
            <div id="cost-history-container" class="overflow-y-auto max-h-56">
              <div id="cost-history-list" class="space-y-2"></div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script is:inline src="/js/toast.js"></script>
<script is:inline src="/js/skeleton.js"></script>
<script>
  const API_URL = CostMaster.API_URL;
  let typeChart, productChart, trendChart;
  let cachedReportData = { distribution: null, rentability: null, audit: null, period: null, variations: null, breakeven: null, costHistory: null };

  function getAuthHeaders() { const token = localStorage.getItem('token'); if (!token) { window.location.href = '/login'; return null; } return { 'Authorization': `Bearer ${token}` }; }

  function getDateParams() {
    const start = document.getElementById('filter-start-date').value;
    const end = document.getElementById('filter-end-date').value;
    const params = new URLSearchParams();
    if (start) params.set('start', start);
    if (end) params.set('end', end);
    const qs = params.toString();
    return qs ? `?${qs}` : '';
  }

  function showSkeletons() {
    const kpiGrid = document.getElementById('kpi-container');
    if (kpiGrid) CostMaster.Skeleton.show(kpiGrid, 'cards', { count: 4 });
    const trendContainer = document.getElementById('trend-chart-container');
    if (trendContainer) CostMaster.Skeleton.show(trendContainer, 'chart', { height: 'h-60' });
    const typeContainer = document.getElementById('type-chart-container');
    if (typeContainer) CostMaster.Skeleton.show(typeContainer, 'chart', { height: 'h-60' });
    const productContainer = document.getElementById('product-chart-container');
    if (productContainer) CostMaster.Skeleton.show(productContainer, 'chart', { height: 'h-60' });
    const rentabilityContainer = document.getElementById('rentability-container');
    if (rentabilityContainer) CostMaster.Skeleton.table(rentabilityContainer, 4, 5);
    const auditContainer = document.getElementById('audit-container');
    if (auditContainer) CostMaster.Skeleton.show(auditContainer, 'rows', { count: 5 });
    const costHistoryContainer = document.getElementById('cost-history-container');
    if (costHistoryContainer) CostMaster.Skeleton.show(costHistoryContainer, 'rows', { count: 5 });
  }

  function renderKPICards(kpiTotal, avg, max, min) {
    const kpiGrid = document.getElementById('kpi-container');
    kpiGrid.className = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-8';
    kpiGrid.innerHTML = `
      <div class="card p-5">
        <div class="text-sm text-[var(--text-muted)] mb-1" data-i18n="report.total_costs">Total Costos</div>
        <div class="text-2xl font-bold font-mono text-gradient" id="kpi-total">${formatCurrency(kpiTotal)}</div>
      </div>
      <div class="card p-5">
        <div class="text-sm text-[var(--text-muted)] mb-1" data-i18n="report.avg_cost">Costo Promedio</div>
        <div class="text-2xl font-bold font-mono text-[var(--text-primary)]" id="kpi-avg">${formatCurrency(avg)}</div>
      </div>
      <div class="card p-5">
        <div class="text-sm text-[var(--text-muted)] mb-1" data-i18n="report.max_cost">Mayor Costo</div>
        <div class="text-2xl font-bold font-mono text-red-400" id="kpi-max">${formatCurrency(max)}</div>
      </div>
      <div class="card p-5">
        <div class="text-sm text-[var(--text-muted)] mb-1" data-i18n="report.min_cost">Menor Costo</div>
        <div class="text-2xl font-bold font-mono text-emerald-400" id="kpi-min">${formatCurrency(min)}</div>
      </div>`;
  }

  function renderEmptyState(container, message) {
    container.innerHTML = `<div class="flex flex-col items-center justify-center h-full py-8 text-[var(--text-muted)]">
      <svg class="w-12 h-12 mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
      </svg>
      <p class="text-sm font-medium">${message}</p>
    </div>`;
  }

  async function load() {
    const headers = getAuthHeaders();
    if (!headers) return;

    showSkeletons();

    try {
      const dateParams = getDateParams();
      const [distRes, rentRes, auditRes, periodRes, varRes, beRes, chRes] = await Promise.all([
        fetch(`${API_URL}/reports/distribution${dateParams}`, { headers }),
        fetch(`${API_URL}/reports/rentability${dateParams}`, { headers }),
        fetch(`${API_URL}/audit?limit=20${dateParams ? '&' + dateParams.slice(1) : ''}`, { headers }),
        fetch(`${API_URL}/reports/period${dateParams}`, { headers }),
        fetch(`${API_URL}/reports/variations${dateParams}`, { headers }),
        fetch(`${API_URL}/reports/break-even`, { headers }),
        fetch(`${API_URL}/costs/history`, { headers })
      ]);

      if (!distRes.ok || !rentRes.ok || !auditRes.ok || !periodRes.ok || !varRes.ok || !beRes.ok || !chRes.ok) {
        throw new Error('Error al cargar los datos del reporte');
      }

      const distribution = await distRes.json();
      const rentability = await rentRes.json();
      const audit = await auditRes.json();
      const period = await periodRes.json();
      const variations = await varRes.json();
      const breakeven = await beRes.json();
      const costHistory = await chRes.json();

      cachedReportData = { distribution, rentability, audit, period, variations, breakeven, costHistory };

      const costs = [...(distribution.direct?.items || []), ...(distribution.indirect?.items || [])];
      const totals = costs.map(c => c.total);
      const kpiTotal = distribution.grandTotal || 0;

      renderKPICards(
        kpiTotal,
        totals.length ? totals.reduce((a, b) => a + b, 0) / totals.length : 0,
        Math.max(...totals, 0),
        totals.length ? Math.min(...totals) : 0
      );

      renderTrendChart(period);
      renderVariations(variations);
      renderBreakEven(breakeven);
      renderTypeChart(distribution);
      renderProductChart(rentability);
      renderRentability(rentability);
      renderAudit(audit);
      renderCostHistory(costHistory);
    } catch (e) {
      console.error(e);
      if (window.toast) window.toast.error('Error al cargar los reportes. Intenta de nuevo.');
      renderKPICards(0, 0, 0, 0);
      renderEmptyState(document.getElementById('trend-chart-container'), 'No hay datos de tendencia disponibles');
      renderEmptyState(document.getElementById('type-chart-container'), 'No hay costos registrados');
      renderEmptyState(document.getElementById('product-chart-container'), 'No hay productos con costos');
      renderEmptyState(document.getElementById('rentability-container'), 'No hay datos de rentabilidad');
      renderEmptyState(document.getElementById('audit-container'), 'Sin actividad registrada');
      renderEmptyState(document.getElementById('cost-history-container'), 'Sin cambios de costos registrados');
    }
  }

  function renderVariations(data) {
    const table = document.getElementById('variations-table');
    if (!data || data.length === 0) { table.innerHTML = ''; return; }
    const esc = CostMaster.sanitize.escapeHtml;
    table.innerHTML = data.map(m => {
      const pct = m.total_variation;
      let badge = '<span class="text-[var(--text-muted)]">—</span>';
      if (pct !== null && pct !== undefined) {
        const cls = pct > 0 ? 'bg-red-500/20 text-red-400' : pct < 0 ? 'bg-emerald-500/20 text-emerald-400' : 'bg-[var(--bg-card)] text-[var(--text-secondary)]';
        badge = `<span class="px-2.5 py-1 rounded-lg text-xs font-semibold ${cls} border ${pct > 0 ? 'border-red-500/30' : pct < 0 ? 'border-emerald-500/30' : 'border-[var(--border-color)]'}">${pct > 0 ? '+' : ''}${pct.toFixed(1)}%</span>`;
      }
      return `<tr class="hover:bg-[var(--bg-tertiary)] transition-colors">
        <td class="table-cell text-[var(--text-secondary)]">${esc(m.label)}</td>
        <td class="table-cell font-mono text-[var(--text-primary)]">${formatCurrency(m.total)}</td>
        <td class="table-cell">${badge}</td>
      </tr>`;
    }).join('');
  }

  function renderBreakEven(data) {
    if (!data) return;
    document.getElementById('breakeven-fixed').textContent = formatCurrency(data.fixed_costs || 0);
    document.getElementById('breakeven-ratio').textContent = `${(data.contribution_ratio || 0).toFixed(1)}%`;
    document.getElementById('breakeven-revenue').textContent = data.break_even_revenue !== null && data.break_even_revenue !== undefined ? formatCurrency(data.break_even_revenue) : '—';
  }

  function renderCostHistory(data) {
    const container = document.getElementById('cost-history-container');
    if (!data || data.length === 0) {
      container.innerHTML = '';
      renderEmptyState(container, 'Sin cambios de costos registrados');
      return;
    }
    const esc = CostMaster.sanitize.escapeHtml;
    container.innerHTML = `<div id="cost-history-list" class="space-y-2">${data.slice(0, 20).map(h => `
      <div class="text-xs p-3 bg-[var(--bg-tertiary)] rounded-lg border border-[var(--border-color)]">
        <div class="flex justify-between">
          <span class="font-medium text-[var(--text-primary)]">${esc(h.product_name || 'General')}</span>
          <span class="text-[var(--text-muted)]">${new Date(h.changed_at).toLocaleDateString('es-MX')}</span>
        </div>
        <div class="text-[var(--text-muted)] mt-1">${formatCurrency(h.old_amount || 0)} → ${formatCurrency(h.new_amount)}</div>
      </div>
    `).join('')}</div>`;
  }

  function exportCSV(filename, rows, headers) {
    const csv = [headers.join(','), ...rows.map(r => r.map(c => `"${String(c ?? '').replace(/"/g, '""')}"`).join(','))].join('\n');
    const blob = new Blob([`\ufeff${csv}`], { type: 'text/csv;charset=utf-8;' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  window.exportReportPDF = function() {
    if (!cachedReportData.distribution) return;
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    const currency = v => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v || 0);

    doc.setFontSize(18);
    doc.setFont('helvetica', 'bold');
    doc.text('CostMaster - Reporte Financiero', 14, 20);
    doc.setFontSize(11);
    doc.setFont('helvetica', 'normal');
    doc.text(`Fecha: ${new Date().toLocaleDateString('es-MX')}`, 14, 28);
    doc.text(`Total de costos: ${currency(cachedReportData.distribution.grandTotal || 0)}`, 14, 34);
    doc.text(`Rango: ${document.getElementById('filter-start-date').value || 'Inicio'} → ${document.getElementById('filter-end-date').value || 'Hoy'}`, 14, 40);

    const margin = 14;
    let y = 48;

    const addSectionTitle = (title) => {
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text(title, margin, y);
      y += 6;
      doc.setFont('helvetica', 'normal');
    };

    addSectionTitle('Análisis de Rentabilidad');
    const rentabilityRows = (cachedReportData.rentability || []).map(p => [p.name, currency(p.total_cost), currency(p.selling_price || 0), `${p.margin.toFixed(1)}%`]);
    doc.autoTable({
      startY: y,
      head: [['Producto', 'Costo Total', 'Precio Venta', 'Margen']],
      body: rentabilityRows,
      margin: { left: margin, right: margin },
      styles: { fontSize: 9 },
      headStyles: { fillColor: [139, 92, 246] }
    });
    y = doc.lastAutoTable.finalY + 12;

    addSectionTitle('Distribución de Costos por Tipo');
    const distRows = [
      ...(cachedReportData.distribution.direct?.items || []).map(i => [`Directo - ${i.type}`, currency(i.total)]),
      ...(cachedReportData.distribution.indirect?.items || []).map(i => [`Indirecto - ${i.type}`, currency(i.total)])
    ];
    doc.autoTable({
      startY: y,
      head: [['Tipo', 'Monto']],
      body: distRows.length ? distRows : [['Sin datos', '$0']],
      margin: { left: margin, right: margin },
      styles: { fontSize: 9 },
      headStyles: { fillColor: [59, 130, 246] }
    });
    y = doc.lastAutoTable.finalY + 12;

    addSectionTitle('Costos por Período');
    const periodRows = (cachedReportData.period || []).map(m => [m.label, currency(m.direct), currency(m.indirect), currency((m.direct || 0) + (m.indirect || 0))]);
    doc.autoTable({
      startY: y,
      head: [['Período', 'Directo', 'Indirecto', 'Total']],
      body: periodRows,
      margin: { left: margin, right: margin },
      styles: { fontSize: 9 },
      headStyles: { fillColor: [16, 185, 129] }
    });
    y = doc.lastAutoTable.finalY + 12;

    if (cachedReportData.breakeven) {
      addSectionTitle('Punto de Equilibrio');
      doc.autoTable({
        startY: y,
        head: [['Concepto', 'Valor']],
        body: [
          ['Costos Fijos', currency(cachedReportData.breakeven.fixed_costs || 0)],
          ['Margen de Contribución', `${(cachedReportData.breakeven.contribution_ratio || 0).toFixed(1)}%`],
          ['Ventas de Equilibrio', cachedReportData.breakeven.break_even_revenue != null ? currency(cachedReportData.breakeven.break_even_revenue) : '—']
        ],
        margin: { left: margin, right: margin },
        styles: { fontSize: 9 },
        headStyles: { fillColor: [245, 158, 11] }
      });
    }

    doc.save(`CostMaster-Reporte-${new Date().toISOString().slice(0, 10)}.pdf`);
  };

  window.exportReportExcel = function() {
    if (!cachedReportData.distribution) return;
    const wb = XLSX.utils.book_new();
    const rentability = (cachedReportData.rentability || []).map(p => ({
      Producto: p.name,
      'Costo Total': p.total_cost,
      'Precio Venta': p.selling_price || 0,
      'Margen (%)': p.margin
    }));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rentability), 'Rentabilidad');
    const period = (cachedReportData.period || []).map(m => ({ Periodo: m.label, Directo: m.direct, Indirecto: m.indirect, Total: (m.direct || 0) + (m.indirect || 0) }));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(period), 'Costos por Periodo');
    if (cachedReportData.variations && cachedReportData.variations.length) {
      const variations = cachedReportData.variations.map(v => ({ Periodo: v.label, Total: v.total, 'Variación (%)': v.total_variation ?? '—' }));
      XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(variations), 'Variaciones');
    }
    if (cachedReportData.breakeven) {
      const be = [{ 'Costos Fijos': cachedReportData.breakeven.fixed_costs, 'Margen de Contribución (%)': cachedReportData.breakeven.contribution_ratio, 'Ventas de Equilibrio': cachedReportData.breakeven.break_even_revenue ?? '—' }];
      XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(be), 'Punto de Equilibrio');
    }
    XLSX.writeFile(wb, `CostMaster-Reporte-${new Date().toISOString().slice(0, 10)}.xlsx`);
  };

  function formatCurrency(v) { return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v || 0); }

  function renderTrendChart(data) {
    const container = document.getElementById('trend-chart-container');
    container.innerHTML = '<canvas id="trendChart"></canvas>';
    const ctx = document.getElementById('trendChart').getContext('2d');
    if (trendChart) trendChart.destroy();

    if (!data || data.length === 0 || data.every(m => m.direct === 0 && m.indirect === 0)) {
      renderEmptyState(container, 'No hay datos de tendencia para mostrar');
      return;
    }

    const totals = data.map(m => (m.direct || 0) + (m.indirect || 0));

    trendChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.map(m => m.label),
        datasets: [
          {
            label: 'Costo Directo',
            data: data.map(m => m.direct || 0),
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            fill: true,
            tension: 0.4
          },
          {
            label: 'Costo Indirecto',
            data: data.map(m => m.indirect || 0),
            borderColor: '#8b5cf6',
            backgroundColor: 'rgba(139, 92, 246, 0.1)',
            fill: true,
            tension: 0.4
          },
          {
            label: 'Total',
            data: totals,
            borderColor: '#ef4444',
            borderDash: [5, 5],
            backgroundColor: 'transparent',
            tension: 0.4
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } },
        scales: { y: { beginAtZero: true } },
        interaction: { intersect: false, mode: 'index' }
      }
    });
  }

  function renderTypeChart(data) {
    const container = document.getElementById('type-chart-container');
    container.innerHTML = '<canvas id="typeChart"></canvas>';
    const ctx = document.getElementById('typeChart').getContext('2d');
    if (typeChart) typeChart.destroy();

    const directData = data?.direct?.items || [];
    const indirectData = data?.indirect?.items || [];

    const totals = {
      materia: directData.find(i => i.type === 'materia_prima')?.total || 0,
      manoObra: directData.find(i => i.type === 'mano_obra')?.total || 0,
      empaque: directData.find(i => i.type === 'empaque')?.total || 0,
      transporte: directData.find(i => i.type === 'transporte')?.total || 0,
      otroDirect: directData.find(i => i.type === 'otro')?.total || 0,
      alquiler: indirectData.find(i => i.type === 'alquiler')?.total || 0,
      servicios: indirectData.find(i => i.type === 'servicios')?.total || 0,
      depreciacion: indirectData.find(i => i.type === 'depreciacion')?.total || 0,
      sueldos: indirectData.find(i => i.type === 'sueldos')?.total || 0,
      otroIndirect: indirectData.find(i => i.type === 'otro')?.total || 0
    };

    const allZero = Object.values(totals).every(v => v === 0);

    if (allZero) {
      renderEmptyState(container, 'No hay costos registrados');
      return;
    }

    typeChart = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Materia Prima', 'Mano Obra', 'Empaque', 'Transp', 'Otro Dir', 'Alquiler', 'Servicios', 'Depreciac', 'Sueldos', 'Otro Ind'],
        datasets: [{
          data: Object.values(totals),
          backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#64748b', '#8b5cf6', '#06b6d4', '#ec4899', '#84cc16', '#6b7280']
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true } }
      }
    });
  }

  function renderProductChart(data) {
    const container = document.getElementById('product-chart-container');
    container.innerHTML = '<canvas id="productChart"></canvas>';
    const ctx = document.getElementById('productChart').getContext('2d');
    if (productChart) productChart.destroy();

    if (!data || data.length === 0 || data.every(p => p.total_cost === 0)) {
      renderEmptyState(container, 'No hay productos con costos');
      return;
    }

    const top5 = data.slice(0, 5);
    productChart = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: top5.map(p => p.name.substring(0, 15)),
        datasets: [
          { label: 'Costo', data: top5.map(p => p.total_cost), backgroundColor: '#ef4444' },
          { label: 'Venta', data: top5.map(p => p.selling_price || 0), backgroundColor: '#10b981' }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } },
        scales: { y: { beginAtZero: true } }
      }
    });
  }

  function renderRentability(data) {
    const container = document.getElementById('rentability-container');
    if (!data || data.length === 0) {
      container.innerHTML = '';
      renderEmptyState(container, 'No hay datos de rentabilidad');
      return;
    }

    const esc = CostMaster.sanitize.escapeHtml;
    container.innerHTML = `
      <table class="w-full text-sm">
        <thead><tr class="table-header"><th class="table-cell" data-i18n="common.name">Producto</th><th class="table-cell" data-i18n="report.cost">Costo</th><th class="table-cell" data-i18n="report.selling_price">Venta</th><th class="table-cell" data-i18n="report.margin">Margen</th></tr></thead>
        <tbody id="rentability-table" class="divide-y divide-[var(--border-color)]">
          ${data.slice(0, 8).map(p => `
            <tr class="hover:bg-[var(--bg-tertiary)] transition-colors">
              <td class="table-cell font-medium text-[var(--text-primary)]">${esc(p.name)}</td>
              <td class="table-cell font-mono text-[var(--text-secondary)]">${formatCurrency(p.total_cost)}</td>
              <td class="table-cell font-mono text-[var(--text-secondary)]">${formatCurrency(p.selling_price || 0)}</td>
              <td class="table-cell"><span class="px-3 py-1.5 rounded-lg text-xs font-semibold ${p.margin >= 20 ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : p.margin >= 0 ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30' : 'bg-red-500/20 text-red-400 border border-red-500/30'}">${p.margin.toFixed(1)}%</span></td>
            </tr>
          `).join('')}
        </tbody>
      </table>`;
  }

  function renderAudit(data) {
    const container = document.getElementById('audit-container');
    if (!data || data.length === 0) {
      container.innerHTML = '';
      renderEmptyState(container, 'Sin actividad registrada');
      return;
    }

    const esc = CostMaster.sanitize.escapeHtml;
    container.innerHTML = `<div id="audit-list" class="space-y-2">${data.map(d => `
      <div class="text-xs p-3 bg-[var(--bg-tertiary)] rounded-lg border border-[var(--border-color)]">
        <div class="flex justify-between">
          <span class="font-medium text-[var(--text-primary)]">${esc(d.table_name)}</span>
          <span class="text-[var(--text-muted)]">${new Date(d.created_at).toLocaleDateString('es-MX')}</span>
        </div>
        <div class="text-[var(--text-muted)]">${esc(d.action)} - Registro #${d.record_id}</div>
      </div>
    `).join('')}</div>`;
  }

  document.getElementById('mobile-menu-btn').addEventListener('click', () => {
    document.querySelector('aside').classList.toggle('-translate-x-full');
  });

  document.getElementById('filter-apply').addEventListener('click', load);
  document.getElementById('filter-clear').addEventListener('click', () => {
    document.getElementById('filter-start-date').value = '';
    document.getElementById('filter-end-date').value = '';
    load();
  });

  document.getElementById('export-pdf').addEventListener('click', () => window.exportReportPDF());
  document.getElementById('export-excel').addEventListener('click', () => window.exportReportExcel());

  load();
</script>
