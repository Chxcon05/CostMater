---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="Costos">
  <div class="flex min-h-screen">
    <Sidebar />
    
    <main class="flex-1 p-4 md:p-8 md:ml-56 relative z-10">
      <button id="mobile-menu-btn" class="md:hidden fixed top-4 right-4 z-50 p-3 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg shadow-lg hover:border-[var(--accent-primary)] transition-all">
        <svg class="w-6 h-6 text-[var(--text-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <PageHeader title="Costos" subtitle="Registra costos directos e indirectos" i18nTitle="cost.page_title" i18nSubtitle="cost.page_subtitle" />
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-8 animate-fade-in-up">
        <div class="card p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-[var(--text-primary)]" data-i18n="cost.direct_title">Costos Directos</h3>
            <span class="text-2xl font-bold text-emerald-400 font-mono" id="total-direct">$0</span>
          </div>
          <p class="text-sm text-[var(--text-muted)]" data-i18n="cost.direct_desc">Materia prima, mano de obra, empaque</p>
        </div>
        <div class="card p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-[var(--text-primary)]" data-i18n="cost.indirect_title">Costos Indirectos</h3>
            <span class="text-2xl font-bold text-amber-400 font-mono" id="total-indirect">$0</span>
          </div>
          <p class="text-sm text-[var(--text-muted)]" data-i18n="cost.indirect_desc">Alquiler, servicios, depreciación</p>
        </div>
      </div>

      <div class="flex gap-3 mb-6 flex-wrap">
        <input type="text" id="search-input" placeholder="Buscar..." class="input max-w-xs" data-i18n-placeholder="common.search" />
        <select id="product-filter" class="input w-full sm:w-auto flex-1 min-w-[150px]">
          <option value="" data-i18n="cost.all_products">Todos los productos</option>
        </select>
        <select id="type-filter" class="input w-full sm:w-auto flex-1 min-w-[120px]">
          <option value="" data-i18n="cost.all_types">Todos los tipos</option>
        </select>
        <select id="cost-type-filter" class="input w-full sm:w-auto flex-1 min-w-[100px]">
          <option value="" data-i18n="common.all">Todos</option>
          <option value="direct" data-i18n="cost.direct">Directos</option>
          <option value="indirect" data-i18n="cost.indirect">Indirectos</option>
        </select>
        <button id="btn-new-direct" class="btn-primary flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs whitespace-nowrap" data-i18n="cost.add_direct" data-tooltip="cost.add_direct">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          Directo
        </button>
        <button id="btn-new-indirect" class="btn-secondary flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs whitespace-nowrap" data-i18n="cost.add_indirect" data-tooltip="cost.add_indirect">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          Indirecto
        </button>
      </div>

      <div class="card mb-4 overflow-x-auto">
        <table class="w-full min-w-[640px]">
          <thead><tr class="table-header"><th class="table-cell" data-i18n="common.name">Producto</th><th class="table-cell" data-i18n="common.type">Tipo</th><th class="table-cell" data-i18n="common.description">Descripción</th><th class="table-cell" data-i18n="common.amount">Monto</th><th class="table-cell" data-i18n="common.date">Fecha</th><th class="table-cell" data-i18n="common.actions">Acciones</th></tr></thead>
          <tbody id="table" class="divide-y divide-[var(--border-color)]"></tbody>
        </table>
        <div id="empty-msg" class="empty-state hidden">
          <div class="empty-state-icon">
            <svg class="w-8 h-8 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          </div>
          <p class="empty-state-title" data-i18n="cost.empty">No hay costos registrados</p>
          <p class="empty-state-desc">Comienza registrando tu primer costo</p>
          <button onclick="document.getElementById('btn-new-direct').click()" class="btn-primary rounded-lg text-xs px-4 py-2" data-i18n="common.add">+ Agregar</button>
        </div>
      </div>

      <div id="pagination-container"></div>
    </main>
  </div>

  <div id="direct-modal" class="modal-overlay hidden">
    <div class="modal-content">
      <div class="p-6 border-b border-[var(--border-color)] flex justify-between items-center">
        <h3 class="text-lg font-semibold" id="modal-title-direct" data-i18n="cost.add_direct">Agregar Costo Directo</h3>
        <button id="btn-close-direct" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <form class="p-6 space-y-4">
        <input type="hidden" id="direct-id" />
        <div class="grid grid-cols-2 gap-4">
          <div data-tooltip="cost.form_product"><label class="label" data-i18n="cost.form_product">Producto *</label><select id="direct-product_id" class="input" required></select><p class="field-error-msg">Selecciona un producto</p></div>
          <div data-tooltip="cost.form_type_label"><label class="label" data-i18n="cost.form_type_label">Tipo *</label><select id="direct-type" class="input"><option value="materia_prima">Materia Prima</option><option value="mano_obra">Mano de Obra</option><option value="empaque">Empaque</option><option value="transporte">Transporte</option><option value="otro">Otro</option></select></div>
        </div>
        <div data-tooltip="cost.form_description"><label class="label" data-i18n="cost.form_description">Descripción *</label><input type="text" id="direct-description" class="input" required /><p class="field-error-msg">La descripción es requerida</p></div>
        <div class="grid grid-cols-2 gap-4">
          <div data-tooltip="cost.form_amount"><label class="label" data-i18n="cost.form_amount">Monto *</label><input type="number" id="direct-amount" class="input" step="0.01" required /><p class="field-error-msg">El monto es requerido</p></div>
          <div><label class="label" data-i18n="cost.form_qty">Cantidad</label><input type="number" id="direct-quantity" class="input" step="0.01" value="1" /></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div><label class="label" data-i18n="cost.form_invoice">N° Factura</label><input type="text" id="direct-invoice" class="input" /></div>
          <div><label class="label" data-i18n="cost.form_date">Fecha de compra</label><input type="date" id="direct-purchase_date" class="input" /></div>
        </div>
      </form>
      <div class="p-6 border-t border-[var(--border-color)] flex gap-3 justify-end">
        <button id="btn-cancel-direct" class="btn-secondary rounded-lg text-sm py-2 px-4" data-i18n="common.cancel">Cancelar</button>
        <button id="btn-save-direct" class="btn-primary rounded-lg text-sm py-2 px-4" data-i18n="common.save">Guardar</button>
      </div>
    </div>
  </div>

  <div id="indirect-modal" class="modal-overlay hidden">
    <div class="modal-content">
      <div class="p-6 border-b border-[var(--border-color)] flex justify-between items-center">
        <h3 class="text-lg font-semibold" id="modal-title-indirect" data-i18n="cost.add_indirect">Agregar Costo Indirecto</h3>
        <button id="btn-close-indirect" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <form class="p-6 space-y-4">
        <input type="hidden" id="indirect-id" />
        <div class="grid grid-cols-2 gap-4">
          <div data-tooltip="cost.form_product_opt"><label class="label" data-i18n="cost.form_product_opt">Producto (opcional)</label><select id="indirect-product_id" class="input"><option value="">General</option></select></div>
          <div data-tooltip="cost.form_type_label"><label class="label" data-i18n="cost.form_type_label">Tipo *</label><select id="indirect-type" class="input"><option value="alquiler">Alquiler</option><option value="servicios">Servicios</option><option value="depreciacion">Depreciación</option><option value="sueldos">Sueldos</option><option value="seguros">Seguros</option><option value="mantenimiento">Mantenimiento</option><option value="impuestos">Impuestos</option><option value="otro">Otro</option></select></div>
        </div>
        <div data-tooltip="cost.form_description"><label class="label" data-i18n="cost.form_description">Descripción *</label><input type="text" id="indirect-description" class="input" required /><p class="field-error-msg">La descripción es requerida</p></div>
        <div class="grid grid-cols-2 gap-4">
          <div data-tooltip="cost.form_amount"><label class="label" data-i18n="cost.form_amount">Monto *</label><input type="number" id="indirect-amount" class="input" step="0.01" required /><p class="field-error-msg">El monto es requerido</p></div>
          <div><label class="label" data-i18n="cost.form_proportion">Proporción (%)</label><input type="number" id="indirect-proportion" class="input" step="0.01" value="100" /></div>
        </div>
      </form>
      <div class="p-6 border-t border-[var(--border-color)] flex gap-3 justify-end">
        <button id="btn-cancel-indirect" class="btn-secondary rounded-lg text-sm py-2 px-4" data-i18n="common.cancel">Cancelar</button>
        <button id="btn-save-indirect" class="btn-primary rounded-lg text-sm py-2 px-4" data-i18n="common.save">Guardar</button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline src="/js/toast.js"></script>
<script is:inline src="/js/pagination.js"></script>
<script is:inline src="/js/tooltips.js"></script>
<script>
  const API = CostMaster.API_URL;
  let directCosts = [], indirectCosts = [], products = [], editDirectId = null;
  let currentPage = 1;
  const perPage = 10;
  let searchTimeout = null;

  const $ = id => document.getElementById(id);

  function auth() {
    const t = localStorage.getItem('token');
    if (!t) { location.href = '/login'; return null; }
    return { Authorization: `Bearer ${t}` };
  }

  async function load() {
    const h = auth();
    if (!h) return;
    try {
      const [dRes, iRes, pRes] = await Promise.all([
        fetch(`${API}/costs/direct`, { headers: h }),
        fetch(`${API}/costs/indirect`, { headers: h }),
        fetch(`${API}/products`, { headers: h })
      ]);
      directCosts = await dRes.json();
      indirectCosts = await iRes.json();
      products = await pRes.json();
      currentPage = 1;
      populateProducts();
      render();
    } catch (e) {
      toast.error(window.t ? window.t('common.error_loading') : 'Error al cargar datos');
    }
  }

  function populateProducts() {
    const esc = CostMaster.sanitize.escapeHtml;
    const opts = products.map(p => `<option value="${p.id}">${esc(p.name)}</option>`).join('');
    $('direct-product_id').innerHTML = opts;
    $('indirect-product_id').innerHTML = '<option value="">General</option>' + opts;
  }

  function render() {
    const s = $('search-input').value.toLowerCase();
    const productId = $('product-filter').value;
    const type = $('type-filter').value;
    const costTypeFilter = $('cost-type-filter').value;

    const esc = CostMaster.sanitize.escapeHtml;
    $('product-filter').innerHTML = '<option value="">Todos los productos</option>' + products.map(p => `<option value="${p.id}">${esc(p.name)}</option>`).join('');
    if (productId) $('product-filter').value = productId;

    $('type-filter').innerHTML = `<option value="">Todos los tipos</option>
      <option value="materia_prima">Materia Prima</option>
      <option value="mano_obra">Mano de Obra</option>
      <option value="empaque">Empaque</option>
      <option value="transporte">Transporte</option>
      <option value="alquiler">Alquiler</option>
      <option value="servicios">Servicios</option>
      <option value="depreciacion">Depreciación</option>
      <option value="sueldos">Sueldos</option>
      <option value="seguros">Seguros</option>
      <option value="mantenimiento">Mantenimiento</option>
      <option value="impuestos">Impuestos</option>
      <option value="otro">Otro</option>`;
    if (type) $('type-filter').value = type;

    const productFilterId = productId ? parseInt(productId) : null;
    let allCosts = [...directCosts.map(c => ({ ...c, costType: 'direct' })), ...indirectCosts.map(c => ({ ...c, costType: 'indirect' }))].filter(c => {
      if (s && !(c.description || '').toLowerCase().includes(s) && !(c.product_name || '').toLowerCase().includes(s)) return false;
      if (productFilterId && c.product_id != productFilterId) return false;
      if (type && c.type !== type) return false;
      if (costTypeFilter && c.costType !== costTypeFilter) return false;
      return true;
    });

    const totalDirect = directCosts.reduce((s, c) => s + (parseFloat(c.amount) * (parseFloat(c.quantity) || 1)), 0);
    const totalIndirect = indirectCosts.reduce((s, c) => s + (parseFloat(c.amount) * (parseFloat(c.proportion) || 100) / 100), 0);
    $('total-direct').textContent = formatCurrency(totalDirect);
    $('total-indirect').textContent = formatCurrency(totalIndirect);

    allCosts.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

    const { items, totalPages } = CostMaster.Pagination.paginate(allCosts, currentPage, perPage);

    $('table').innerHTML = items.map(c => `
      <tr class="hover:bg-[var(--bg-tertiary)] transition-colors">
        <td class="table-cell font-medium text-[var(--text-primary)]">${esc(c.product_name) || '-'}</td>
        <td class="table-cell"><span class="px-3 py-1.5 rounded-lg text-xs font-semibold ${c.costType === 'direct' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-400 border border-amber-500/30'}">${esc(c.type)}</span></td>
        <td class="table-cell text-[var(--text-secondary)]">${esc(c.description)}</td>
        <td class="table-cell font-mono font-semibold text-[var(--text-primary)]">${formatCurrency(parseFloat(c.amount) * (parseFloat(c.quantity) || 1))}</td>
        <td class="table-cell text-[var(--text-muted)]">${new Date(c.created_at).toLocaleDateString('es-MX')}</td>
        <td class="table-cell">
          <button class="btn-edit-cost p-2 text-[var(--text-muted)] hover:text-[var(--accent-secondary)] transition-colors" data-type="${c.costType}" data-id="${c.id}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          </button>
          <button class="btn-delete-cost p-2 text-[var(--text-muted)] hover:text-[var(--accent-danger)] transition-colors" data-type="${c.costType}" data-id="${c.id}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        </td>
      </tr>
    `).join('');

    $('empty-msg').classList.toggle('hidden', allCosts.length > 0);
    $('table').closest('.card').querySelector('table').style.display = allCosts.length > 0 ? '' : 'none';

    CostMaster.Pagination.render($('pagination-container'), { page: currentPage, totalPages, onPageChange: (p) => { currentPage = p; render(); } });

    document.querySelectorAll('.btn-edit-cost').forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.dataset.type;
        const id = parseInt(btn.dataset.id);
        if (type === 'direct') {
          const cost = directCosts.find(c => c.id === id);
          if (cost) openDirectModal(cost);
        } else {
          const cost = indirectCosts.find(c => c.id === id);
          if (cost) openIndirectModal(cost);
        }
      });
    });

    document.querySelectorAll('.btn-delete-cost').forEach(btn => {
      btn.addEventListener('click', () => deleteCost(btn.dataset.type, parseInt(btn.dataset.id)));
    });
  }

  function formatCurrency(v) { return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v || 0); }

  function validateField(id, condition) {
    const field = $(id);
    const group = field.closest('div[data-tooltip]') || field.parentElement;
    if (!condition) { group.classList.add('field-error'); return false; }
    group.classList.remove('field-error');
    return true;
  }

  function clearValidation() {
    document.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));
  }

  function openDirectModal(cost = null) {
    clearValidation();
    const modal = $('direct-modal');
    modal.classList.remove('hidden');
    if (cost) {
      $('modal-title-direct').textContent = 'Editar Costo Directo';
      const idEl = $('direct-id');
      if (idEl) idEl.value = cost.id || '';
      const prodEl = $('direct-product_id');
      if (prodEl) prodEl.value = cost.product_id || '';
      $('direct-type').value = cost.type || 'materia_prima';
      $('direct-description').value = cost.description || '';
      $('direct-amount').value = cost.amount || '';
      $('direct-quantity').value = cost.quantity || 1;
      $('direct-invoice').value = cost.invoice_number || '';
      $('direct-purchase_date').value = cost.purchase_date || '';
    } else {
      $('modal-title-direct').textContent = 'Agregar Costo Directo';
      $('direct-id').value = '';
      ['direct-product_id','direct-type','direct-description','direct-amount','direct-quantity','direct-invoice','direct-purchase_date'].forEach(f => {
        const el = $(f);
        if (el) el.value = '';
      });
      $('direct-quantity').value = '1';
    }
  }

  function openIndirectModal(cost = null) {
    clearValidation();
    const modal = $('indirect-modal');
    modal.classList.remove('hidden');
    if (cost) {
      $('modal-title-indirect').textContent = 'Editar Costo Indirecto';
      const idEl = $('indirect-id');
      if (idEl) idEl.value = cost.id || '';
      $('indirect-product_id').value = cost.product_id || '';
      $('indirect-type').value = cost.type || 'alquiler';
      $('indirect-description').value = cost.description || '';
      $('indirect-amount').value = cost.amount || '';
      $('indirect-proportion').value = cost.proportion || 100;
    } else {
      $('modal-title-indirect').textContent = 'Agregar Costo Indirecto';
      $('indirect-id').value = '';
      ['indirect-product_id','indirect-type','indirect-description','indirect-amount','indirect-proportion'].forEach(f => {
        const el = $(f);
        if (el) el.value = '';
      });
      $('indirect-proportion').value = '100';
    }
  }

  function closeDirectModal() { $('direct-modal').classList.add('hidden'); }
  function closeIndirectModal() { $('indirect-modal').classList.add('hidden'); }

  async function saveDirect() {
    const h = auth();
    if (!h) return;

    if (!validateField('direct-description', $('direct-description').value.trim())) {
      toast.warning('La descripción es requerida');
      return;
    }
    if (!validateField('direct-amount', $('direct-amount').value)) {
      toast.warning('El monto es requerido');
      return;
    }

    const id = $('direct-id').value;
    const product_id = $('direct-product_id').value;

    const data = {
      product_id: product_id ? parseInt(product_id) : null,
      type: $('direct-type').value,
      description: $('direct-description').value,
      amount: parseFloat($('direct-amount').value),
      quantity: parseFloat($('direct-quantity').value) || 1,
      invoice_number: $('direct-invoice').value,
      purchase_date: $('direct-purchase_date').value
    };

    const btn = $('btn-save-direct');
    btn.classList.add('btn-loading');

    try {
      const url = (id && id !== 'undefined') ? `${API}/costs/direct/${id}` : `${API}/costs/direct`;
      const res = await fetch(url, {
        method: (id && id !== 'undefined') ? 'PUT' : 'POST',
        headers: { ...h, 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        closeDirectModal();
        toast.success(window.t ? window.t('common.saved') : 'Guardado correctamente');
        load();
      } else {
        const err = await res.json().catch(() => ({ error: 'Error al guardar' }));
        toast.error(err.error || 'Error al guardar el costo directo');
      }
    } catch (e) {
      toast.error(window.t ? window.t('common.error_saving') : 'Error al guardar');
    } finally {
      btn.classList.remove('btn-loading');
    }
  }

  async function saveIndirect() {
    const h = auth();
    if (!h) return;

    if (!validateField('indirect-description', $('indirect-description').value.trim())) {
      toast.warning('La descripción es requerida');
      return;
    }
    if (!validateField('indirect-amount', $('indirect-amount').value)) {
      toast.warning('El monto es requerido');
      return;
    }

    const id = $('indirect-id').value;
    const productIdElement = $('indirect-product_id');
    const productId = productIdElement ? productIdElement.value : '';

    const data = {
      product_id: productId ? parseInt(productId) : null,
      type: $('indirect-type').value,
      description: $('indirect-description').value,
      amount: parseFloat($('indirect-amount').value) || 0,
      proportion: parseFloat($('indirect-proportion').value) || 100
    };

    const btn = $('btn-save-indirect');
    btn.classList.add('btn-loading');

    try {
      const url = (id && id !== 'undefined') ? `${API}/costs/indirect/${id}` : `${API}/costs/indirect`;
      const res = await fetch(url, {
        method: (id && id !== 'undefined') ? 'PUT' : 'POST',
        headers: { ...h, 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        closeIndirectModal();
        toast.success(window.t ? window.t('common.saved') : 'Guardado correctamente');
        load();
      } else {
        const err = await res.json().catch(() => ({ error: 'Error al guardar' }));
        toast.error(err.error || 'Error al guardar el costo indirecto');
      }
    } catch (e) {
      toast.error(window.t ? window.t('common.error_saving') : 'Error al guardar');
    } finally {
      btn.classList.remove('btn-loading');
    }
  }

  async function deleteCost(type, id) {
    if (!confirm('¿Eliminar costo?')) return;
    const h = auth();
    if (!h) return;
    try {
      await fetch(`${API}/costs/${type}/${id}`, { method: 'DELETE', headers: h });
      toast.success(window.t ? window.t('common.deleted') : 'Eliminado');
      load();
    } catch (e) {
      toast.error(window.t ? window.t('common.error') : 'Error al eliminar');
    }
  }

  $('search-input').addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => { currentPage = 1; render(); }, 300);
  });
  $('product-filter').addEventListener('change', () => { currentPage = 1; render(); });
  $('type-filter').addEventListener('change', () => { currentPage = 1; render(); });
  $('cost-type-filter').addEventListener('change', () => { currentPage = 1; render(); });
  $('btn-new-direct').addEventListener('click', () => openDirectModal());
  $('btn-new-indirect').addEventListener('click', () => openIndirectModal());
  $('btn-close-direct').addEventListener('click', closeDirectModal);
  $('btn-cancel-direct').addEventListener('click', closeDirectModal);
  $('btn-save-direct').addEventListener('click', saveDirect);
  $('btn-close-indirect').addEventListener('click', closeIndirectModal);
  $('btn-cancel-indirect').addEventListener('click', closeIndirectModal);
  $('btn-save-indirect').addEventListener('click', saveIndirect);

  ['direct-modal', 'indirect-modal'].forEach(id => {
    $(id).addEventListener('click', e => { if (e.target.classList.contains('modal-overlay')) $(id).classList.add('hidden'); });
  });

  document.getElementById('mobile-menu-btn').addEventListener('click', () => {
    document.querySelector('aside').classList.toggle('-translate-x-full');
  });

  if (window.Tooltips) Tooltips.injectAll();
  load();
</script>
