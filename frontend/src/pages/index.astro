---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CostMaster - Sistema de Contabilidad">
<div class="landing-wrapper" id="landing">
<nav class="fixed top-0 left-0 right-0 z-50 bg-[var(--bg-primary)]/80 backdrop-blur-sm border-b border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-6 py-3 flex justify-between items-center">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 bg-[var(--accent-primary)] rounded-sm flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2.5" d="M4 4h8v16H4zM12 4v16M20 4v16" />
            </svg>
          </div>
          <span class="text-lg font-semibold tracking-tight">COSTMASTER</span>
        </a>
        <div class="flex items-center gap-2">
          <button
            id="theme-toggle-nav"
            onclick="window.toggleTheme()"
            class="w-8 h-8 flex items-center justify-center rounded-lg text-[var(--text-muted)] hover:bg-[var(--bg-tertiary)] hover:text-[var(--text-primary)] transition-colors"
            title="Toggle theme"
          >
            <svg id="theme-icon-sun-nav" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="theme-icon-moon-nav" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
            </svg>
          </button>
          <button
            id="lang-toggle-nav"
            onclick="window.toggleLanguage()"
            class="w-8 h-8 flex items-center justify-center rounded-lg text-xs font-bold text-[var(--text-muted)] hover:bg-[var(--bg-tertiary)] hover:text-[var(--text-primary)] transition-colors"
            title="Toggle language"
          >
            <span id="lang-icon-nav">EN</span>
          </button>
          <a href="/login" class="btn btn-secondary text-xs py-1.5 px-3" style="border-radius: 2px" data-i18n="landing.login">Login</a>
          <a href="/register" class="btn btn-primary text-xs py-1.5 px-3" style="border-radius: 2px" data-i18n="landing.start">Comenzar</a>
        </div>
      </div>
    </nav>

    <section class="hero min-h-screen flex items-center justify-center relative overflow-hidden" id="hero">
      <canvas id="hero-canvas" class="absolute inset-0"></canvas>
      
      <div class="hero-glow"></div>
      
      <div class="floating-elements">
        <div class="float-element" data-delay="0">
          <svg viewBox="0 0 100 100" class="w-20 h-20 opacity-20">
            <rect x="20" y="20" width="60" height="60" fill="none" stroke="var(--accent-primary)" stroke-width="2" transform="rotate(45 50 50)"/>
          </svg>
        </div>
        <div class="float-element" data-delay="2000">
          <svg viewBox="0 0 100 100" class="w-16 h-16 opacity-15">
            <circle cx="50" cy="50" r="30" fill="none" stroke="var(--accent-secondary)" stroke-width="2"/>
          </svg>
        </div>
        <div class="float-element" data-delay="4000">
          <svg viewBox="0 0 100 100" class="w-24 h-24 opacity-10">
            <polygon points="50,10 90,90 10,90" fill="none" stroke="var(--accent-tertiary)" stroke-width="2"/>
          </svg>
        </div>
        <div class="float-element" data-delay="1000">
          <svg viewBox="0 0 100 100" class="w-12 h-12 opacity-20">
            <rect x="20" y="20" width="60" height="60" rx="10" fill="none" stroke="var(--accent-primary)" stroke-width="2"/>
          </svg>
        </div>
        <div class="float-element" data-delay="3000">
          <svg viewBox="0 0 100 100" class="w-14 h-14 opacity-15">
            <line x1="20" y1="20" x2="80" y2="80" stroke="var(--accent-secondary)" stroke-width="2"/>
            <line x1="80" y1="20" x2="20" y2="80" stroke="var(--accent-secondary)" stroke-width="2"/>
          </svg>
        </div>
      </div>

      <div class="connection-lines">
        <svg class="absolute inset-0 w-full h-full" preserveAspectRatio="none">
          <line class="conn-line" x1="20%" y1="30%" x2="35%" y2="25%" />
          <line class="conn-line" x1="80%" y1="25%" x2="65%" y2="30%" />
          <line class="conn-line" x1="25%" y1="70%" x2="40%" y2="75%" />
          <line class="conn-line" x1="75%" y1="75%" x2="60%" y2="70%" />
        </svg>
      </div>
      
      <div class="max-w-4xl mx-auto px-6 text-center relative z-10 py-20">
        <div class="hero-badges" style="opacity: 0; transform: translateY(-20px);">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-sm bg-[var(--bg-card)] border border-[var(--border-color)] mb-8">
            <span class="w-2 h-2 bg-[var(--accent-success)] rounded-full relative animate-pulse">
              <span class="absolute inset-0 rounded-full bg-[var(--accent-success)] animate-ping"></span>
            </span>
            <span class="text-xs text-[var(--text-muted)] uppercase tracking-wider" data-i18n="landing.cost_subtitle">Contabilidad de costos</span>
          </div>
        </div>
        
        <h1 class="text-4xl md:text-7xl font-bold mb-5 tracking-tight leading-tight">
          <span class="hero-title" style="opacity: 0; transform: translateY(40px); display: inline-block;">
            <span data-i18n="landing.hero_title_calc">Calcula tus</span> <span class="text-[var(--accent-primary)]">costos</span>, <br class="hidden md:block"/>
            <span data-i18n="landing.hero_title_scale">escala tu</span> <span class="text-[var(--accent-secondary)]">negocio</span>
          </span>
        </h1>
        
        <p class="text-base md:text-lg text-[var(--text-secondary)] mb-8 max-w-xl mx-auto hero-subtitle" style="opacity: 0; transform: translateY(30px);" data-i18n="landing.hero_subtitle">
          La herramienta profesional para calcular, analizar y optimizar cada peso de tu negocio. 
          Decisiones basadas en datos reales.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-16 hero-cta" style="opacity: 0; transform: translateY(20px);">
          <a href="/register" class="btn btn-primary py-3 px-6 text-base group" style="border-radius: 2px" data-i18n="landing.free">
            Prueba Gratis
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/features" class="btn btn-secondary py-3 px-6 text-base" style="border-radius: 2px" data-i18n="landing.learn">
            Conocer más
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 hero-stats">
          <div class="stat-card" style="opacity: 0; transform: translateY(30px) scale(0.9);">
            <div class="card p-5 hover:-translate-y-2 hover:shadow-lg hover:shadow-[var(--accent-primary)]/10">
              <div class="text-3xl font-bold font-mono text-[var(--accent-primary)]">100%</div>
              <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wide mt-2" data-i18n="landing.stat_online">Online</div>
            </div>
          </div>
          <div class="stat-card" style="opacity: 0; transform: translateY(30px) scale(0.9); animation-delay: 0.05s;">
            <div class="card p-5 hover:-translate-y-2 hover:shadow-lg hover:shadow-[var(--accent-secondary)]/10">
              <div class="text-3xl font-bold font-mono text-[var(--accent-secondary)]">0$</div>
              <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wide mt-2" data-i18n="landing.stat_cost">Costo inicial</div>
            </div>
          </div>
          <div class="stat-card" style="opacity: 0; transform: translateY(30px) scale(0.9); animation-delay: 0.1s;">
            <div class="card p-5 hover:-translate-y-2 hover:shadow-lg hover:shadow-[var(--accent-tertiary)]/10">
              <div class="text-3xl font-bold font-mono text-[var(--accent-tertiary)]">∞</div>
              <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wide mt-2" data-i18n="landing.stat_products">Productos</div>
            </div>
          </div>
          <div class="stat-card" style="opacity: 0; transform: translateY(30px) scale(0.9); animation-delay: 0.15s;">
            <div class="card p-5 hover:-translate-y-2 hover:shadow-lg hover:shadow-[var(--accent-primary)]/10">
              <div class="text-3xl font-bold font-mono text-[var(--accent-primary)]">24/7</div>
              <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wide mt-2" data-i18n="landing.stat_access">Acceso</div>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-wave">
        <svg viewBox="0 0 1440 320" preserveAspectRatio="none" class="absolute bottom-0 w-full">
          <path fill="var(--bg-secondary)" fill-opacity="1" d="M0,192L48,197.3C96,203,192,213,288,229.3C384,245,480,267,576,250.7C672,235,768,181,864,181.3C960,181,1056,235,1152,234.7C1248,235,1344,181,1392,154.7L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
        </svg>
      </div>

      <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M12 5v14M5 12l7 7 7-7" />
        </svg>
      </div>
    </section>

    <section class="features py-28 relative" id="features">
      <div class="features-bg"></div>
      
      <div class="max-w-5xl mx-auto px-6 relative">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-semibold mb-4 features-title" style="opacity: 0; transform: translateY(30px);">
            <span class="text-[var(--accent-primary)]" data-i18n="landing.features_title">Características</span>
          </h2>
          <p class="text-[var(--text-muted)] text-lg features-subtitle" style="opacity: 0; transform: translateY(30px);" data-i18n="landing.features_subtitle">
            Todo lo que necesitas para gestionar tu negocio
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-5">
          <div class="feature-card" style="opacity: 0; transform: translateY(40px);">
            <div class="card p-6 h-full relative overflow-hidden group">
              <div class="feature-icon feature-icon-1">
                <svg class="w-6 h-6 text-[var(--accent-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16l-2 12H6L4 6z" />
                </svg>
              </div>
              <div class="absolute -right-8 -top-8 w-24 h-24 bg-[var(--accent-primary)]/5 rounded-full blur-2xl group-hover:bg-[var(--accent-primary)]/20 transition-all"></div>
              <h3 class="text-lg font-semibold mb-3 relative z-10" data-i18n="page.products">Gestión de Productos</h3>
              <p class="text-sm text-[var(--text-muted)] relative z-10" data-i18n="landing.feat_products_desc">Registra y organiza todos tus productos y servicios con facilidad. Control total de tu inventario.</p>
              <div class="feature-line feature-line-1"></div>
            </div>
          </div>
          
          <div class="feature-card" style="opacity: 0; transform: translateY(40px); animation-delay: 0.1s;">
            <div class="card p-6 h-full relative overflow-hidden group">
              <div class="feature-icon feature-icon-2">
                <svg class="w-6 h-6 text-[var(--accent-secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0-1V7" />
                </svg>
              </div>
              <div class="absolute -right-8 -top-8 w-24 h-24 bg-[var(--accent-secondary)]/5 rounded-full blur-2xl group-hover:bg-[var(--accent-secondary)]/20 transition-all"></div>
              <h3 class="text-lg font-semibold mb-3 relative z-10" data-i18n="landing.cost_title">Costos Detallados</h3>
              <p class="text-sm text-[var(--text-muted)] relative z-10" data-i18n="landing.feat_costs_desc">Controla costos directos e indirectos por producto. Calcula márgenes precisos.</p>
              <div class="feature-line feature-line-2"></div>
            </div>
          </div>
          
          <div class="feature-card" style="opacity: 0; transform: translateY(40px); animation-delay: 0.2s;">
            <div class="card p-6 h-full relative overflow-hidden group">
              <div class="feature-icon feature-icon-3">
                <svg class="w-6 h-6 text-[var(--accent-tertiary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <div class="absolute -right-8 -top-8 w-24 h-24 bg-[var(--accent-tertiary)]/5 rounded-full blur-2xl group-hover:bg-[var(--accent-tertiary)]/20 transition-all"></div>
              <h3 class="text-lg font-semibold mb-3 relative z-10" data-i18n="page.reports">Reportes y Análisis</h3>
              <p class="text-sm text-[var(--text-muted)] relative z-10" data-i18n="landing.feat_reports_desc">Visualiza rentabilidad y toma decisiones informadas con gráficos.</p>
              <div class="feature-line feature-line-3"></div>
            </div>
          </div>
        </div>

        <div class="mt-16 grid md:grid-cols-2 gap-5">
          <div class="feature-card" style="opacity: 0; transform: translateX(-30px);">
            <div class="card p-5 flex items-center gap-4">
              <div class="feature-mini-icon">
                <svg class="w-5 h-5 text-[var(--accent-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h4 class="font-semibold mb-1" data-i18n="landing.secure">Datos Seguros</h4>
                <p class="text-xs text-[var(--text-muted)]" data-i18n="landing.secure_desc">Tu información siempre protegida</p>
              </div>
            </div>
          </div>
          <div class="feature-card" style="opacity: 0; transform: translateX(30px); animation-delay: 0.1s;">
            <div class="card p-5 flex items-center gap-4">
              <div class="feature-mini-icon">
                <svg class="w-5 h-5 text-[var(--accent-secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div>
                <h4 class="font-semibold mb-1" data-i18n="landing.instant">Análisis Instantáneo</h4>
                <p class="text-xs text-[var(--text-muted)]" data-i18n="landing.instant_desc">Resultados en tiempo real</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="demo py-28 relative overflow-hidden" id="demo">
      <div class="demo-bg"></div>
      
      <div class="max-w-5xl mx-auto px-6 relative">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-semibold mb-4" data-i18n="landing.platform">
            Una plataforma <span class="text-[var(--accent-primary)]">completa</span>
          </h2>
          <p class="text-[var(--text-muted)]" data-i18n="landing.platform_desc">Todo lo que necesitas en un solo lugar</p>
        </div>

        <div class="demo-mockup">
          <div class="mockup-header">
            <div class="mockup-dots">
              <span></span><span></span><span></span>
            </div>
            <div class="mockup-title">CostMaster - Dashboard</div>
            <div class="mockup-url">costmaster.app</div>
          </div>
          <div class="mockup-content">
            <div class="mockup-sidebar">
              <div class="mockup-nav-item active">
                <div class="mockup-nav-icon"></div>
              </div>
              <div class="mockup-nav-item">
                <div class="mockup-nav-icon"></div>
              </div>
              <div class="mockup-nav-item">
                <div class="mockup-nav-icon"></div>
              </div>
              <div class="mockup-nav-item">
                <div class="mockup-nav-icon"></div>
              </div>
              <div class="mockup-nav-item">
                <div class="mockup-nav-icon"></div>
              </div>
              <div class="mockup-nav-item">
                <div class="mockup-nav-icon"></div>
              </div>
            </div>
            <div class="mockup-main">
              <div class="mockup-header-bar">
                <div class="mockup-search"></div>
                <div class="mockup-user"></div>
              </div>
              <div class="mockup-cards">
                <div class="mockup-card">
                  <div class="mockup-card-label">Total Ingresos</div>
                  <div class="mockup-card-value">$24,580</div>
                  <div class="mockup-card-trend up">+12.5%</div>
                </div>
                <div class="mockup-card">
                  <div class="mockup-card-label">Productos</div>
                  <div class="mockup-card-value">156</div>
                  <div class="mockup-card-trend up">+8</div>
                </div>
                <div class="mockup-card">
                  <div class="mockup-card-label">Costos</div>
                  <div class="mockup-card-value">$8,420</div>
                  <div class="mockup-card-trend down">-3.2%</div>
                </div>
                <div class="mockup-card">
                  <div class="mockup-card-label">Margen</div>
                  <div class="mockup-card-value">65.7%</div>
                  <div class="mockup-card-trend up">+5.1%</div>
                </div>
              </div>
              <div class="mockup-chart">
                <div class="mockup-chart-title">Rentabilidad por Producto</div>
                <div class="mockup-chart-area">
                  <div class="mockup-bar" style="height: 80%"></div>
                  <div class="mockup-bar" style="height: 60%"></div>
                  <div class="mockup-bar" style="height: 95%"></div>
                  <div class="mockup-bar" style="height: 45%"></div>
                  <div class="mockup-bar" style="height: 70%"></div>
                  <div class="mockup-bar" style="height: 55%"></div>
                  <div class="mockup-bar" style="height: 85%"></div>
                </div>
                <div class="mockup-chart-labels">
                  <span> Producto A</span>
                  <span> Producto B</span>
                  <span> Producto C</span>
                  <span> Producto D</span>
                  <span> Producto E</span>
                  <span> Producto F</span>
                  <span> Producto G</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="cta py-28 relative overflow-hidden" data-speed="0.1">
      <div class="cta-particles"></div>
      <div class="absolute inset-0 bg-[var(--bg-secondary)]"></div>
      
      <div class="max-w-2xl mx-auto px-6 text-center relative z-10 cta-content" style="opacity: 0; transform: scale(0.9);">
        <h2 class="text-4xl font-bold mb-4" data-i18n="landing.ready">
          ¿<span class="rainbow-hover">Listo</span> para empezar?
        </h2>
        <p class="text-[var(--text-muted)] text-lg mb-10" data-i18n="landing.join">
          Únete a emprendedores que ya optimizan sus costos con CostMaster
        </p>
        <a href="/register" class="btn btn-primary py-4 px-10 text-lg group inline-flex" style="border-radius: 2px" data-i18n="landing.cta">
          Comenzar Gratuitamente
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>

    <footer class="py-8 border-t border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 bg-[var(--accent-primary)] rounded-sm flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 4h8v16H4zM12 4v16M20 4v16" />
              </svg>
            </div>
            <span class="text-sm font-semibold">COSTMASTER</span>
          </div>
          <p class="text-xs text-[var(--text-muted)]" data-i18n="footer.rights">
            © 2026 CostMaster. Todos los derechos reservados.
          </p>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .hero-glow {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 50% 40% at 50% 0%, rgba(139, 92, 246, 0.15) 0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 100%, rgba(16, 185, 129, 0.1) 0%, transparent 50%);
  }

  .floating-elements {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .float-element {
    position: absolute;
    animation: floatRandom 8s ease-in-out infinite;
  }

  .float-element:nth-child(1) { top: 15%; left: 10%; }
  .float-element:nth-child(2) { top: 20%; right: 15%; }
  .float-element:nth-child(3) { bottom: 30%; left: 15%; }
